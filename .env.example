# Web3Forms Configuration
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Resend Email Configuration (if using custom email API)
RESEND_API_KEY=your_resend_api_key_here
# Optional but recommended: use a verified sender/domain in Resend
# REQUIRED for any email to actually send. Must be an address on a domain
# verified at resend.com/domains. There is no working default: Resend's
# shared onboarding@resend.dev sender only delivers to the account owner's
# own inbox and returns 403 for every other recipient.
RESEND_FROM_EMAIL=you@your-verified-domain.com
# Where submissions should be delivered (falls back to RESEND_FROM_EMAIL if unset)
CONTACT_EMAIL=your_contact_email@domain.com

# MailerLite (newsletter)
# Create a MailerLite API token and a subscriber group ID.
MAILERLITE_API_TOKEN=your_mailerlite_api_token_here
MAILERLITE_GROUP_ID=your_mailerlite_group_id_here
# Optional: override if MailerLite changes API base URL
MAILERLITE_API_BASE_URL=https://connect.mailerlite.com/api

# Chat assistant (Groq primary, Gemini fallback, OpenRouter tertiary)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Analytics
GA_MEASUREMENT_ID=G-FMSF6Y2DYL

# Calendly booking link, offered as an escape hatch from the chat intake flow
# (optional — leave unset to hide the "Book a call" option entirely)
CALENDLY_URL=https://calendly.com/your-handle/intro-call

# Standalone chat backend (server/) base URL. Local dev: http://localhost:8080.
# Production: your Railway custom domain, e.g. https://api.nasifsalaam.com
# Must be PUBLIC_-prefixed to be readable in the client bundle (Vite convention).
PUBLIC_CHAT_API_BASE=http://localhost:8080
