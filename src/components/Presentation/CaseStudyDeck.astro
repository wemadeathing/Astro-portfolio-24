---
type CaseStudy = {
  title: string;
  subtitle: string;
  context: { role: string; duration: string; challenge: string };
  approach: { steps: { phase: string; description: string; deliverables: string[]; images?: string[] }[] };
  solution: { features: string[]; tech: string[] };
  impact: { metrics: { value: string; label: string; description: string }[] };
  images: string[];
  overview: string[];
  solutionImage?: string;
};

interface Props {
  caseNumber: string;
  caseStudy: CaseStudy;
  metaLeftLabel: string;
  metaRightLabel: string;
  stackLabel: string;
}

const { caseNumber, caseStudy, metaLeftLabel, metaRightLabel, stackLabel } = Astro.props;

const approachImages = caseStudy.images.slice(0, 4);
const solutionImage = caseStudy.solutionImage ?? caseStudy.images?.[0] ?? '';

const getStepGallery = (stepIndex: number, size = 3) => {
  const images = caseStudy.images ?? [];
  if (images.length === 0) return [];
  const start = (stepIndex * size) % images.length;
  return Array.from({ length: Math.min(size, images.length) }, (_, i) => images[(start + i) % images.length]);
};
---

<!-- Title slide -->
<section>
  <div class="min-h-[100dvh] w-full flex items-center justify-center px-8 pt-6 pb-40">
    <div class="w-full max-w-[1100px] text-center">
      <div class="mx-auto max-w-[80ch]">
        <div class="section-kicker mb-3">Case study {caseNumber}</div>
        <h2 class="type-h1">{caseStudy.title}</h2>
        <div class="mt-3 font-mono text-[11px] uppercase tracking-[0.16em] text-primary">
          {caseStudy.subtitle}
        </div>

        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-[900px] mx-auto">
          <div class="border-t border-border/80 p-5 text-center">
            <div class="mb-2 font-mono text-[11px] uppercase tracking-[0.22em] text-muted-foreground">{metaLeftLabel}</div>
            <div class="text-sm sm:text-base leading-[1.65] text-foreground">
              {caseStudy.context.role}
            </div>
          </div>
          <div class="border-t border-border/80 p-5 text-center">
            <div class="mb-2 font-mono text-[11px] uppercase tracking-[0.22em] text-muted-foreground">{metaRightLabel}</div>
            <div class="text-sm sm:text-base leading-[1.65] text-foreground">
              {caseStudy.context.duration}
            </div>
          </div>
        </div>

        <div class="mt-4 border-t border-primary/25 p-6 max-w-[900px] mx-auto">
          <div class="section-kicker text-primary mb-2">Challenge</div>
          <div class="text-sm sm:text-base leading-[1.7] text-muted-foreground">
            {caseStudy.context.challenge}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Approach -->
<section>
  <div class="min-h-[100dvh] w-full flex items-center justify-center px-8 pt-6 pb-40">
    <div class="w-full max-w-[1300px]">
      <div class="text-center mb-10">
        <div class="section-kicker mb-3">{caseStudy.title}</div>
        <h2 class="type-h2">Approach and process</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {caseStudy.approach.steps.map((step, index) => {
          const stepGallery = getStepGallery(index, 3);
          const explicitGallery = (step.images ?? []).filter(Boolean);
          const gallery = explicitGallery.length > 0 ? explicitGallery : stepGallery;
          const stepImage = gallery[0] ?? approachImages[index] ?? caseStudy.images[0];

          return (
            <button
              type="button"
              class="group overflow-hidden rounded-lg border border-border/80 bg-card/30 text-left transition-colors hover:bg-card/50 hover:border-primary/25 focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/20"
              data-gallery-item={stepImage}
              data-gallery-items={JSON.stringify(gallery)}
              aria-label={`Open visual for ${caseStudy.title}: ${step.phase}`}
            >
              <div class="relative w-full aspect-[16/9]">
                <img
                  src={stepImage}
                  alt={`${caseStudy.title}: ${step.phase}`}
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/10 to-black/0"></div>
              </div>

              <div class="p-6">
                <div class="text-lg font-semibold text-foreground">{step.phase}</div>
                <div class="mt-2 text-sm leading-[1.65] text-muted-foreground">{step.description}</div>
                <div class="mt-4 space-y-2">
                  {step.deliverables.map((deliverable) => (
                    <div class="flex items-start gap-3 text-sm text-muted-foreground">
                      <div class="mt-2 h-2 w-2 border border-primary bg-primary/70"></div>
                      <div class="leading-[1.6]">{deliverable}</div>
                    </div>
                  ))}
                </div>
              </div>
            </button>
          );
        })}
      </div>
    </div>
  </div>
</section>

<!-- Solution -->
<section>
  <div class="min-h-[100dvh] w-full flex items-center justify-center px-8 pt-6 pb-40">
    <div class="w-full max-w-[1300px]">
      <div class="text-center mb-10">
        <div class="section-kicker mb-3">{caseStudy.title}</div>
        <h2 class="type-h2">Solution</h2>
      </div>

      <div class="mx-auto w-full max-w-[1200px] grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="rounded-lg border border-border/80 p-5 text-left">
          {solutionImage ? (
            <button
              type="button"
              class="group relative w-full overflow-hidden rounded-md border border-border/80 bg-card/20 focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/20"
              data-gallery-item={solutionImage}
              aria-label={`Open ${caseStudy.title} solution visual`}
            >
              <img
                src={solutionImage}
                alt={`${caseStudy.title} solution visual`}
                class="h-[330px] sm:h-[360px] w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                loading="lazy"
                decoding="async"
              />
              <div class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-white/0 transition-colors group-hover:ring-white/10"></div>
            </button>
          ) : (
            <div class="h-[330px] sm:h-[360px] w-full rounded-md border border-border/80 bg-card/20" />
          )}
        </div>

        <div class="rounded-lg border border-border/80 p-7 text-left">
          <div class="mb-3 text-left font-mono text-[11px] uppercase tracking-[0.22em] text-muted-foreground">What shipped</div>
          <div class="space-y-3">
            {caseStudy.solution.features.map((feature) => (
              <div class="flex items-start gap-3 text-muted-foreground">
                <div class="mt-2 h-2 w-2 border border-primary bg-primary/70"></div>
                <div class="text-sm sm:text-base leading-[1.7]">{feature}</div>
              </div>
            ))}
          </div>

          <div class="mt-6 pt-6 border-t border-border/80">
            <div class="mb-3 text-left font-mono text-[11px] uppercase tracking-[0.22em] text-muted-foreground">{stackLabel}</div>
            <div class="flex flex-wrap gap-2">
              {caseStudy.solution.tech.map((tech) => (
                <span class="inline-flex items-center rounded-md border border-border/80 px-3 py-1 font-mono text-[11px] uppercase tracking-[0.14em] text-muted-foreground">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Impact -->
<section>
  <div class="min-h-[100dvh] w-full flex items-center justify-center px-8 pt-6 pb-40">
    <div class="w-full max-w-[1300px]">
      <div class="text-center mb-10">
        <div class="section-kicker mb-3">{caseStudy.title}</div>
        <h2 class="type-h2">Impact</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {caseStudy.impact.metrics.map((metric) => (
          <div class="border-t border-border/80 p-6 text-center">
            <div class="text-3xl lg:text-[34px] font-semibold tracking-[-0.03em] text-primary">{metric.value}</div>
            <div class="mt-2 text-sm font-semibold text-foreground">{metric.label}</div>
            <div class="mt-2 text-sm leading-[1.6] text-muted-foreground">{metric.description}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
