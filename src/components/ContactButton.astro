---
// Flexible button component that accepts props for URL and text
interface Props {
  href?: string;
  text?: string;
  external?: boolean;
}

const { 
  href = "/contact", 
  text = "Let's Connect",
  external = false 
} = Astro.props;
---

<a
  href={href}
  class="btn-stripe min-h-[48px] px-8"
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  {text}
</a>
