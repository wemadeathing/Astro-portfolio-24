---
interface Props {
  title: string;
  description: string;
  image: string;
  tags: string[];
  slug: string;
  /** Heading level for the card title, so it stays correct in the surrounding
      page's heading hierarchy. Defaults to h3 (used under a page's h1/h2 sections). */
  headingLevel?: 'h2' | 'h3';
}

const { title, description, image, tags, slug, headingLevel = 'h3' } = Astro.props;
const primaryTag = tags?.[0];
const Heading = headingLevel;
---

<a
  href={`/projects/${slug}`}
  class="group flex h-full flex-col overflow-hidden rounded-lg border border-border/80 transition-colors hover:border-primary/35 focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/20"
>
  {/* Image */}
  <div class="relative aspect-[16/10] overflow-hidden bg-muted/20">
    <img
      src={image}
      alt={title}
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
      loading="lazy"
      decoding="async"
    />
  </div>

  {/* Content: heading fixed to one line, description to two, so every
      card in a row totals the same three lines of text and the footer
      strip lands at the same height regardless of copy length. */}
  <div class="flex flex-1 flex-col p-4">
    <Heading class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors line-clamp-1 leading-snug">
      {title}
    </Heading>
    <p class="mt-1.5 text-xs sm:text-sm text-muted-foreground line-clamp-2 leading-relaxed">
      {description}
    </p>

    <div class="flex-1"></div>

    {/* Footer */}
    <div class="mt-3 flex items-center gap-2 border-t border-border/60 pt-3">
      {primaryTag && (
        <span class="font-mono text-xs lowercase tracking-[0.06em] text-muted-foreground">
          {primaryTag}
        </span>
      )}
      <svg
        class="ml-auto h-3 w-3 -translate-x-1 text-primary opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100"
        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
      >
        <path d="M7 17L17 7" /><path d="M7 7h10v10" />
      </svg>
    </div>
  </div>
</a>
