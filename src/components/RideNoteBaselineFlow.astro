---
const steps = [
  {
    src: '/images/work/ridenote/ridenote-baseline-basics.webp',
    title: 'The bike itself',
    caption: 'Nickname, photo, and type. What the hardware can do.',
  },
  {
    src: '/images/work/ridenote/ridenote-baseline-config.webp',
    title: 'The baseline',
    caption: 'Tires, wheels, suspension, and sag. The typical starting setup, stored once.',
  },
  {
    src: '/images/work/ridenote/ridenote-baseline-suspension.webp',
    title: 'Dialed to the psi',
    caption: 'Every value is a slider with a real range, not a bare text field.',
  },
];
---

<section class="not-prose rn-baseline-flow my-12" aria-labelledby="rn-baseline-flow-title">
  <div class="rn-baseline-flow__header">
    <div>
      <div class="rn-baseline-flow__kicker">Bike configuration vs. baseline</div>
      <h3 id="rn-baseline-flow-title">What the hardware can do vs. what you run</h3>
    </div>
    <p>The split described above, as it renders on a bike's own settings screen.</p>
  </div>

  <div class="rn-baseline-flow__steps">
    {steps.map((step, index) => (
      <figure class="rn-baseline-flow__step">
        <figcaption>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div>
            <strong>{step.title}</strong>
            <em>{step.caption}</em>
          </div>
        </figcaption>
        <button
          type="button"
          class="rn-baseline-flow__phone"
          data-image-src={step.src}
          data-image-alt={`${step.title}: ${step.caption}`}
          data-gallery="ridenote-baseline-flow"
          aria-label={`Open ${step.title}`}
        >
          <img
            src={step.src}
            alt={`${step.title}: ${step.caption}`}
            width="1170"
            height="2532"
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </button>
      </figure>
    ))}
  </div>
</section>

<style>
  .rn-baseline-flow {
    border-block: 1px solid hsl(var(--border) / 0.72);
    padding-block: clamp(1.5rem, 4vw, 2.75rem);
  }

  .rn-baseline-flow__header {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(18rem, 0.8fr);
    gap: clamp(1rem, 4vw, 3rem);
    align-items: end;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  .rn-baseline-flow__kicker {
    color: hsl(var(--muted-foreground));
    font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .rn-baseline-flow h3 {
    margin: 0.35rem 0 0;
    color: hsl(var(--foreground));
    font-size: clamp(1.45rem, 2.5vw, 2rem);
    font-weight: 600;
    line-height: 1.12;
  }

  .rn-baseline-flow__header p {
    margin: 0;
    max-width: 36rem;
    color: hsl(var(--muted-foreground));
    font-size: clamp(0.95rem, 1.2vw, 1.05rem);
    line-height: 1.65;
  }

  .rn-baseline-flow__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .rn-baseline-flow__step {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 0.9rem;
    margin: 0;
  }

  .rn-baseline-flow figcaption {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.15rem 0.6rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.88rem;
    line-height: 1.5;
    text-align: left;
    align-items: start;
  }

  .rn-baseline-flow figcaption span {
    color: var(--case-accent);
    font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    line-height: 1.8;
  }

  .rn-baseline-flow figcaption strong,
  .rn-baseline-flow figcaption em {
    display: block;
  }

  .rn-baseline-flow figcaption strong {
    color: hsl(var(--foreground));
    font-style: normal;
    font-weight: 600;
  }

  .rn-baseline-flow figcaption em {
    margin-top: 0.12rem;
    font-style: normal;
  }

  /* Phone frame: matches the calculator flow and v2 gallery so every real
     screenshot in the case study reads as one consistent device treatment. */
  .rn-baseline-flow__phone {
    position: relative;
    display: block;
    width: 100%;
    cursor: zoom-in;
    border: 1px solid hsl(var(--border) / 0.75);
    border-radius: 1.6rem;
    background: linear-gradient(155deg, hsl(0 0% 15%), hsl(0 0% 6%));
    padding: 0.4rem;
  }

  .rn-baseline-flow__phone::after {
    content: "";
    position: absolute;
    top: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    width: 30%;
    height: 0.85rem;
    background: #000;
    border-radius: 999px;
    z-index: 2;
    pointer-events: none;
  }

  .rn-baseline-flow__phone img {
    display: block;
    width: 100%;
    height: auto;
    /* Top corners round to match the bezel; bottom stays square so flush
       bottom-edge UI (buttons, sliders) never gets clipped by the mask. */
    border-radius: 1.25rem 1.25rem 0.3rem 0.3rem;
    transition: transform 220ms ease, filter 220ms ease;
  }

  .rn-baseline-flow__phone:hover img {
    filter: contrast(1.02);
    transform: scale(1.01);
  }

  @media (max-width: 800px) {
    .rn-baseline-flow__header {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
  }

  @media (max-width: 640px) {
    .rn-baseline-flow__steps {
      grid-template-columns: 1fr;
      max-width: 20rem;
      margin-inline: auto;
    }
  }
</style>
