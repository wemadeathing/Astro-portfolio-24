---
// Flexible button component that supports primary and secondary variants
interface Props {
  href?: string;
  text?: string;
  variant?: 'primary' | 'secondary';
  external?: boolean;
  class?: string;
}

const { 
  href = "/contact", 
  text = "Button",
  variant = 'primary',
  external = false,
  class: className = ""
} = Astro.props;

const getButtonClasses = (variant: string) => {
  const baseClasses =
    "btn-stripe focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/30";

  if (variant === 'primary') {
    return `${baseClasses}`;
  } else {
    return `${baseClasses}`;
  }
};
---

<a
  href={href}
  class={`${getButtonClasses(variant)} ${className}`}
  data-tone={variant === 'secondary' ? 'muted' : 'primary'}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  {text}
</a>
