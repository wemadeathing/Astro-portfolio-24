---
interface Props {
  title: string;
  vertical?: boolean;
}

const { title, vertical = false } = Astro.props;
const currentUrl = Astro.url.href;
const encodedUrl = encodeURIComponent(currentUrl);
const encodedTitle = encodeURIComponent(title);

const shareLinks = [
  {
    name: 'Twitter',
    url: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
  },
  {
    name: 'LinkedIn',
    url: `https://www.linkedin.com/shareArticle?mini=true&url=${encodedUrl}&title=${encodedTitle}`,
  },
];
---

<div class={`flex ${vertical ? 'flex-col gap-3' : 'flex-wrap gap-x-5 gap-y-2'}`}>
  {shareLinks.map((link) => (
    <a
      href={link.url}
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground transition-colors hover:text-foreground focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/20"
      aria-label={`Share on ${link.name}`}
    >
      <span class="h-px w-5 bg-border/80 transition-colors group-hover:bg-primary/40" aria-hidden="true"></span>
      <span>{link.name}</span>
    </a>
  ))}
</div>
