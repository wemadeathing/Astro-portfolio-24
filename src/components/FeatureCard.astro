---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="flex items-start gap-3 py-1">
  <div class="mt-2 h-1.5 w-1.5 shrink-0 bg-primary/70"></div>
  <div>
    {/* !mt-0/!mb-0: this codebase's .prose h3 rule (global, in [slug].astro)
        sets mt-10 on every h3. Override it here since this h3 sits in a
        tight flex row, not flowing body text. */}
    <h3 class="!mt-0 !mb-0 text-base font-semibold text-foreground">{title}</h3>
    <div class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
      <slot />
    </div>
  </div>
</div>
