---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="relative overflow-hidden border-t border-border/80 px-0 py-4 transition-colors duration-300 hover:border-primary/35">
  <h3 class="mb-1.5 text-lg font-semibold text-foreground">{title}</h3>
  <div class="text-base leading-relaxed text-muted-foreground">
    <slot />
  </div>
</div>
