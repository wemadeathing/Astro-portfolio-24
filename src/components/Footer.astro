---
import NewsletterForm from './NewsletterForm.astro';
---

<footer class="mt-10 border-t border-border/80 bg-background/70 backdrop-blur">
  <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    <div class="md:hidden mb-8 space-y-8">
      <div>
        <div class="text-xs tracking-[0.22em] uppercase text-muted-foreground/70 mb-3">About</div>
        <div class="text-sm text-muted-foreground leading-[1.65]">
          Design Engineer · AI Systems, Skills & Governance. I design and build AI systems, and help organisations use them responsibly.
        </div>
      </div>
      <div>
        <div class="text-xs tracking-[0.22em] uppercase text-muted-foreground/70 mb-3">Services & writing</div>
        <nav class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
          <a href="/work-with-me" class="text-muted-foreground hover:text-foreground transition-colors">Work With Me</a>
          <a href="/blog" class="text-muted-foreground hover:text-foreground transition-colors">Insights</a>
          <a href="/resources" class="text-muted-foreground hover:text-foreground transition-colors">Resources</a>
        </nav>
      </div>
      <div>
        <div class="text-xs tracking-[0.22em] uppercase text-muted-foreground/70 mb-3">Elsewhere</div>
        <nav class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
          <a href="https://github.com/wemadeathing" class="text-muted-foreground hover:text-foreground transition-colors" rel="noopener noreferrer" target="_blank">GitHub</a>
          <a href="https://www.linkedin.com/in/nasifsalaam/" class="text-muted-foreground hover:text-foreground transition-colors" rel="noopener noreferrer" target="_blank">LinkedIn</a>
          <a href="https://www.behance.net/nsalaam" class="text-muted-foreground hover:text-foreground transition-colors" rel="noopener noreferrer" target="_blank">Behance</a>
        </nav>
      </div>
      <div>
        <div class="text-xs tracking-[0.22em] uppercase text-muted-foreground/70 mb-3">Newsletter</div>
        <div class="text-sm text-muted-foreground leading-[1.65] mb-3">
          Occasional product + AI notes. 1–2 emails/month. No spam.
        </div>
        <NewsletterForm />
      </div>
    </div>

    <div class="hidden md:grid grid-cols-[1.1fr_0.75fr_0.75fr_1.4fr] gap-10 mb-6">
      <div class="max-w-[56ch]">
        <div class="text-xs tracking-[0.22em] uppercase text-muted-foreground/70 mb-3">About</div>
        <div class="text-sm text-muted-foreground leading-[1.65]">
          Design Engineer · AI Systems, Skills & Governance. I design and build AI systems, and help organisations use them responsibly.
        </div>
      </div>

      <div>
        <div class="text-xs tracking-[0.22em] uppercase text-muted-foreground/70 mb-3">Services & writing</div>
        <nav class="space-y-2">
          <a href="/work-with-me" class="block text-sm text-muted-foreground hover:text-foreground transition-colors">Work With Me</a>
          <a href="/blog" class="block text-sm text-muted-foreground hover:text-foreground transition-colors">Insights</a>
          <a href="/resources" class="block text-sm text-muted-foreground hover:text-foreground transition-colors">Resources</a>
        </nav>
      </div>

      <div>
        <div class="text-xs tracking-[0.22em] uppercase text-muted-foreground/70 mb-3">Elsewhere</div>
        <nav class="space-y-2">
          <a href="https://github.com/wemadeathing" class="block text-sm text-muted-foreground hover:text-foreground transition-colors" rel="noopener noreferrer" target="_blank">
            GitHub
          </a>
          <a href="https://www.linkedin.com/in/nasifsalaam/" class="block text-sm text-muted-foreground hover:text-foreground transition-colors" rel="noopener noreferrer" target="_blank">
            LinkedIn
          </a>
          <a href="https://www.behance.net/nsalaam" class="block text-sm text-muted-foreground hover:text-foreground transition-colors" rel="noopener noreferrer" target="_blank">
            Behance
          </a>
        </nav>
      </div>

      <div>
        <div class="text-xs tracking-[0.22em] uppercase text-muted-foreground/70 mb-3">Newsletter</div>
        <div class="text-sm text-muted-foreground leading-[1.65]">
          Occasional product + AI notes. 1–2 emails/month. No spam.
        </div>
        <div class="mt-4">
          <NewsletterForm />
        </div>
      </div>
    </div>

    <div class="mt-6 pt-4 border-t border-border/70 flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="text-[11px] text-muted-foreground/70 text-center sm:text-left max-w-xl leading-relaxed">
        <span class="text-muted-foreground/80">© {new Date().getFullYear()} Nasif Salaam.</span>
        <span class="block sm:inline sm:ml-1 text-muted-foreground/60">
          This portfolio doubles as a sandbox for experiments in UI, AI, and how I ship work.
        </span>
      </div>
      <div class="flex items-center gap-3 text-[11px]">
        <a href="/contact" class="text-muted-foreground/70 hover:text-foreground transition-colors">Let’s connect</a>
      </div>
    </div>
  </div>
</footer>
