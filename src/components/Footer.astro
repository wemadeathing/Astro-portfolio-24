---

<footer class="site-footer mt-10">
  <!-- Diagonal stripe band -->
  <div class="footer-stripe" aria-hidden="true"></div>

  <div class="footer-body">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">

      <!-- One responsive grid rather than separate mobile and desktop trees.
           The two had already drifted — mobile carried a "Get in Touch"
           section desktop folded into the bio column, and every edit had to
           be made twice or silently applied to one breakpoint only. -->
      <!-- Two columns, not three: a wide bio against two narrow link stacks
           left the row visibly lopsided and the column bottoms ragged. The
           nav links that used to sit here (Ask AI / Work / About) are in the
           sticky header on every page, so repeating them cost a column
           without adding any reach. -->
      <div class="grid gap-8 md:grid-cols-[1.5fr_1fr] md:gap-16 mb-8">
        <div class="max-w-[56ch]">
          <div class="footer-label">Who I Am</div>
          <div class="footer-body-text">
            Product designer and AI builder with fifteen plus years across brand, digital products, systems, and implementation.
          </div>
        </div>

        <div>
          <div class="footer-label">Get in Touch</div>
          <nav class="flex flex-wrap gap-x-4 gap-y-2 md:block md:space-y-2">
            <a href="mailto:hello@nasifsalaam.com" class="footer-link md:block">hello@nasifsalaam.com</a>
            <a href="https://wa.me/27814623628" class="footer-link md:block" rel="noopener noreferrer" target="_blank">WhatsApp</a>
            <a href="/Nasif-Salaam-Resume.pdf" download class="footer-link md:block">Download CV</a>
          </nav>
        </div>
      </div>

      <!-- Bottom bar doubles as the home for the things that don't warrant a
           column of their own: two side destinations plus the view toggle.
           The tagline that used to sit next to the copyright was a second
           bio, three lines under the first one. -->
      <div class="pt-5 border-t border-border/30 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="text-xs text-muted-foreground/80 text-center sm:text-left">
          © {new Date().getFullYear()} Nasif Salaam
        </div>
        <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
          <a href="/blog" class="font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground/80 transition-colors hover:text-foreground">Insights</a>
          <a href="https://ai.nasifsalaam.com" rel="noopener noreferrer" target="_blank" class="font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground/80 transition-colors hover:text-foreground">AI Training</a>
          <button type="button" id="footer-agent-toggle" class="font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground/80 transition-colors hover:text-foreground">
            Agent View
          </button>
        </nav>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  function initFooterAgentToggle() {
    // Single button now that the footer is one responsive tree — there used
    // to be a separate mobile/desktop pair to keep in sync.
    var trigger = document.getElementById('agent-view-toggle');
    var btn = document.getElementById('footer-agent-toggle');
    if (btn && trigger) {
      btn.onclick = function() { trigger.click(); };
    }
  }
  initFooterAgentToggle();
  document.addEventListener('astro:page-load', initFooterAgentToggle);
</script>

<style>
  .footer-stripe {
    height: 24px;
    width: 100%;
    background-image: repeating-linear-gradient(
      119deg,
      color-mix(in srgb, hsl(var(--foreground)) 20%, transparent) 0 1px,
      transparent 1px 5px
    );
    background-color: hsl(var(--muted));
  }

  .footer-body {
    background-color: hsl(var(--muted));
  }

  .footer-label {
    font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: hsl(var(--muted-foreground) / 0.7);
    margin-bottom: 0.75rem;
  }

  .footer-body-text {
    font-size: 0.875rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.65;
  }

  .footer-link {
    font-size: 0.875rem;
    color: hsl(var(--muted-foreground));
    text-decoration: none;
    transition: color 150ms ease;
  }

  .footer-link:hover {
    color: hsl(var(--foreground));
  }

  /* Hide the floating agent-view toggle in human view, the footer link
     replaces it there. In agent mode the footer is hidden, so the pill
     must stay visible as the way back to human view. */
  :global(html:not(.agent-mode) #agent-view-toggle) {
    display: none !important;
  }
</style>
