---
interface Props {
  items: {
    category: string;
    tools: string[];
  }[];
}

const { items } = Astro.props;
---

<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-6 my-10 not-prose">
  {items.map((group) => (
    <div>
      <h4 class="mb-2 font-mono text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground/70">
        {group.category}
      </h4>
      <p class="text-sm leading-7 text-foreground/90">
        {group.tools.join(' / ')}
      </p>
    </div>
  ))}
</div>
