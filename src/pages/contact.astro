---
export const prerender = true;
import Layout from '../layouts/Layout.astro';

const emailAddress = 'hello@nasifsalaam.com';
// WhatsApp link with obfuscated number (assembled at runtime)
const whatsappHref = `https://wa.me/${['27', '81', '462', '3628'].join('')}?text=${encodeURIComponent("Hi! I'd like to discuss a project with you.")}`;
const responseTime = '24 hours';

const agentMarkdown = `# Contact: Nasif Salaam

> Looking to hire, collaborate, or book a workshop. Send a note and I will reply with next steps. Usually within ${responseTime}.

## Channels

- **Email:** ${emailAddress}
- **Calendly (30 min):** https://calendly.com/salaam-nasif/30min
- **LinkedIn:** https://www.linkedin.com/in/nasifsalaam/
- **Contact form:** https://nasifsalaam.com/contact/

## What to include

- What you are trying to build / solve
- Timeline and any hard deadlines
- Budget range (helps me reply with a useful answer)
- Whether you need design, build, training, or all of the above`;
---

<Layout 
  title="Contact | Nasif Salaam"
  description="Get in touch about AI products, MVPs, product design, or high-trust digital presence work."
  agentMarkdown={agentMarkdown}
  agentPathLabel="~/nasifsalaam / contact.md"
>
  <section class="py-10 sm:py-14">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto stagger-children">
        <h1 class="type-h1 text-white/95">Get in touch</h1>
        <p class="mt-4 type-lead text-white/80">
          Best fit: AI products, MVPs, product design, and high-trust websites or digital presence work.
        </p>
        <p class="mt-2 text-sm text-white/68">
          Usually within {responseTime}.
        </p>

        <div class="mt-8 grid gap-x-8 gap-y-4 sm:grid-cols-3">
          <div>
            <div class="text-xs tracking-[0.18em] uppercase text-white/45">01</div>
            <div class="mt-2 text-sm font-semibold text-white/88">AI product or MVP</div>
            <p class="mt-2 text-sm text-white/68 leading-[1.6]">New builds, internal tools, rapid prototyping, or solo-to-team product work.</p>
          </div>
          <div>
            <div class="text-xs tracking-[0.18em] uppercase text-white/45">02</div>
            <div class="mt-2 text-sm font-semibold text-white/88">Product design + build</div>
            <p class="mt-2 text-sm text-white/68 leading-[1.6]">Systems, UX, interface design, and implementation that need one joined-up thread.</p>
          </div>
          <div>
            <div class="text-xs tracking-[0.18em] uppercase text-white/45">03</div>
            <div class="mt-2 text-sm font-semibold text-white/88">High-trust website</div>
            <p class="mt-2 text-sm text-white/68 leading-[1.6]">Brand-led digital presence for businesses that need to look sharper and more credible.</p>
          </div>
        </div>

        <div class="mt-10">
        <form
          id="contact-form"
          class="rounded-[24px] border border-white/8 bg-white/[0.025] p-6 sm:p-7 space-y-5"
          method="POST"
          aria-label="Contact form"
        >
          <!-- Honeypot (spam protection) -->
          <div class="hidden" aria-hidden="true">
            <label for="company">Company</label>
            <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div>
            <label for="name" class="block text-sm font-medium text-white/85 mb-2">
              Name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              autocomplete="name"
              placeholder="Your name"
              class="w-full rounded-[18px] bg-[#131313]/45 border border-white/8 px-4 py-3 text-white/90 placeholder:text-white/40 focus:border-primary/60 focus:outline-none focus:ring-4 focus:ring-primary/12 transition-colors"
              required
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-white/85 mb-2">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              autocomplete="email"
              inputmode="email"
              placeholder="you@company.com"
              class="w-full rounded-[18px] bg-[#131313]/45 border border-white/8 px-4 py-3 text-white/90 placeholder:text-white/40 focus:border-primary/60 focus:outline-none focus:ring-4 focus:ring-primary/12 transition-colors"
              required
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-white/85 mb-2">
              Message
            </label>
            <textarea
              id="message"
              name="message"
              rows="7"
              placeholder="Tell me what you’re building, which lane this fits into, timelines, budget range if helpful, and what kind of support you need."
              class="w-full rounded-[18px] bg-[#131313]/45 border border-white/8 px-4 py-3 text-white/90 placeholder:text-white/40 focus:border-primary/60 focus:outline-none focus:ring-4 focus:ring-primary/12 transition-colors resize-y"
              required
            ></textarea>
          </div>

          <div id="formStatus" class="hidden text-sm" role="status" aria-live="polite" aria-atomic="true">
            <p class="error hidden rounded-lg bg-destructive/15 border border-destructive/30 px-4 py-3 text-destructive">
              <span class="sr-only">Error:</span>
              <span class="font-medium">⚠ </span>
              <span data-error-text>There was an error sending your message. Please try again.</span>
            </p>
            <p class="success hidden rounded-lg bg-green-500/15 border border-green-500/30 px-4 py-3 text-green-400">
              <span class="sr-only">Success:</span>
              <span class="font-medium">✓ </span>
              Message sent successfully!
            </p>
            <p class="loading hidden rounded-lg bg-primary/15 border border-primary/30 px-4 py-3 text-primary">
              <span class="sr-only">Loading:</span>
              <span class="animate-pulse">Sending message...</span>
            </p>
          </div>

          <button
            type="submit"
            id="submitButton"
            class="inline-flex h-12 items-center justify-center rounded-full bg-primary px-8 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 disabled:opacity-60 disabled:cursor-not-allowed focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/20"
            aria-describedby="formStatus"
          >
            Send message
          </button>
        </form>

        <div class="mt-6 text-sm text-white/68">
          Prefer direct contact?
        </div>

        <div class="mt-3 flex flex-wrap items-center gap-3">
          <a
            href={`mailto:${emailAddress}?subject=${encodeURIComponent('New project enquiry')}`}
            class="inline-flex h-10 items-center justify-center rounded-full border border-white/12 bg-white/[0.03] px-4 text-xs font-semibold text-white/85 transition-colors hover:bg-white/[0.06] hover:text-white"
          >
            Email
          </a>

          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-10 items-center justify-center rounded-full border border-primary/18 bg-primary/8 px-4 text-xs font-semibold text-white/90 transition-colors hover:bg-primary/12 hover:border-primary/32 focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/20"
          >
            WhatsApp
          </a>

          <span class="text-xs text-white/68">
            {emailAddress}
          </span>
        </div>
      </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  const form = document.getElementById('contact-form');
  const formStatus = document.getElementById('formStatus');
  const errorMessage = formStatus?.querySelector('.error');
  const errorText = errorMessage?.querySelector('[data-error-text]');
  const successMessage = formStatus?.querySelector('.success');
  const loadingMessage = formStatus?.querySelector('.loading');
  const submitButton = document.getElementById('submitButton');

  const setBusy = (busy) => {
    if (submitButton) submitButton.disabled = busy;
    if (form) form.setAttribute('aria-busy', busy ? 'true' : 'false');
  };

  form?.addEventListener('submit', function (e) {
    e.preventDefault();

    // Show loading state
    setBusy(true);
    formStatus?.classList.remove('hidden');
    errorMessage?.classList.add('hidden');
    successMessage?.classList.add('hidden');
    loadingMessage?.classList.remove('hidden');

    const formData = new FormData(form);
    const object = Object.fromEntries(formData);

    fetch('/api/send-email', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Accept: 'application/json',
      },
      body: JSON.stringify(object),
    })
      .then(async (response) => {
        const json = await response.json().catch(() => ({}));
        if (response.ok && json.success) {
          window.location.href = '/thank-you';
          return;
        }

        const msg = typeof json?.error === 'string' && json.error.trim().length
          ? json.error
          : 'There was an error sending your message. Please try again.';

        if (errorText) errorText.textContent = msg;

        loadingMessage?.classList.add('hidden');
        errorMessage?.classList.remove('hidden');
      })
      .catch(() => {
        loadingMessage?.classList.add('hidden');
        errorMessage?.classList.remove('hidden');
      })
      .finally(() => {
        setBusy(false);
      });
  });
</script>
