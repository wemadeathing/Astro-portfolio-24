---
export const prerender = true;
import Layout from '../layouts/Layout.astro';

const emailAddress = 'hello@nasifsalaam.com';
const whatsappHref = `https://wa.me/${['27', '81', '462', '3628'].join('')}?text=${encodeURIComponent("Hi! I'd like to discuss a project with you.")}`;
const responseTime = '24 hours';

const contactTracks = [
  {
    label: 'AI product or MVP',
    description: 'New builds, internal tools, rapid prototyping, or solo-to-team product work.',
  },
  {
    label: 'Product design + build',
    description: 'Systems, UX, interface design, and implementation that need one joined-up thread.',
  },
  {
    label: 'High-trust website',
    description: 'Brand-led digital presence for businesses that need to look sharper and more credible.',
  },
];

const quickChannels = [
  { label: 'Email', value: emailAddress, href: `mailto:${emailAddress}?subject=${encodeURIComponent('New project enquiry')}` },
  { label: 'WhatsApp', value: 'Start a chat', href: whatsappHref, external: true },
  { label: 'LinkedIn', value: 'nasifsalaam', href: 'https://www.linkedin.com/in/nasifsalaam/', external: true },
];

const agentMarkdown = `# Contact: Nasif Salaam

> Looking to hire, collaborate, or book a workshop. Send a note and I will reply with next steps. Usually within ${responseTime}.

## Channels

- **Email:** ${emailAddress}
- **Calendly (30 min):** https://calendly.com/salaam-nasif/30min
- **LinkedIn:** https://www.linkedin.com/in/nasifsalaam/
- **Contact form:** https://nasifsalaam.com/contact/

## What to include

- What you are trying to build / solve
- Timeline and any hard deadlines
- Budget range (helps me reply with a useful answer)
- Whether you need design, build, training, or all of the above`;
---

<Layout 
  title="Contact | Nasif Salaam"
  description="Get in touch about AI products, MVPs, product design, or high-trust digital presence work."
  agentMarkdown={agentMarkdown}
  agentPathLabel="~/nasifsalaam / contact.md"
>
  <section class="py-10 sm:py-14">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl">
        <div class="text-center">
          <div class="section-kicker justify-center">Contact</div>
          <h1 class="type-h1 mt-4">Get in touch</h1>
        </div>

        <p class="mx-auto mt-5 max-w-[58ch] text-center text-base leading-[1.8] text-muted-foreground sm:text-lg">
          Best fit: AI products, MVPs, product design, and high-trust websites or digital presence work. Open to project work and full-time roles.
        </p>

        <p class="mt-3 text-center font-mono text-[11px] uppercase tracking-[0.14em] text-muted-foreground">
          Usually within {responseTime}.
        </p>

        <div class="mt-10 grid gap-x-8 gap-y-5 sm:grid-cols-3">
          {contactTracks.map((track, index) => (
            <div class="border-t border-border/80 pt-4">
              <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground">
                0{index + 1}
              </div>
              <div class="mt-2 text-sm font-medium text-foreground">
                {track.label}
              </div>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">
                {track.description}
              </p>
            </div>
          ))}
        </div>

        <div class="mt-10 border-t border-border/80 pt-5">
          <div class="mb-6 font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground">
            Send a note
          </div>

          <form
            id="contact-form"
            class="space-y-6"
            method="POST"
            aria-label="Contact form"
          >
              <div class="hidden" aria-hidden="true">
                <label for="company">Company</label>
                <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
              </div>

              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label for="name" class="mb-2 block font-mono text-[11px] uppercase tracking-[0.14em] text-muted-foreground">
                    Name
                  </label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    autocomplete="name"
                    placeholder="Your name"
                    class="w-full border border-border/80 bg-background px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary/60 focus:outline-none focus:ring-4 focus:ring-primary/12 transition-colors"
                    required
                  />
                </div>

                <div>
                  <label for="email" class="mb-2 block font-mono text-[11px] uppercase tracking-[0.14em] text-muted-foreground">
                    Email
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    autocomplete="email"
                    inputmode="email"
                    placeholder="you@company.com"
                    class="w-full border border-border/80 bg-background px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary/60 focus:outline-none focus:ring-4 focus:ring-primary/12 transition-colors"
                    required
                  />
                </div>
              </div>

              <div>
                <label for="message" class="mb-2 block font-mono text-[11px] uppercase tracking-[0.14em] text-muted-foreground">
                  Message
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="8"
                  placeholder="Tell me what you’re building, your timeline, budget range if helpful, and whether this is a project or a role."
                  class="w-full resize-y border border-border/80 bg-background px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary/60 focus:outline-none focus:ring-4 focus:ring-primary/12 transition-colors"
                  required
                ></textarea>
              </div>

              <div id="formStatus" class="hidden text-sm" role="status" aria-live="polite" aria-atomic="true">
                <p class="error hidden border border-destructive/30 bg-destructive/15 px-4 py-3 text-destructive">
                  <span class="sr-only">Error:</span>
                  <span class="font-medium">⚠ </span>
                  <span data-error-text>There was an error sending your message. Please try again.</span>
                </p>
                <p class="success hidden border border-green-500/30 bg-green-500/15 px-4 py-3 text-green-400">
                  <span class="sr-only">Success:</span>
                  <span class="font-medium">✓ </span>
                  Message sent successfully!
                </p>
                <p class="loading hidden border border-primary/30 bg-primary/15 px-4 py-3 text-primary">
                  <span class="sr-only">Loading:</span>
                  <span class="animate-pulse">Sending message...</span>
                </p>
              </div>

              <div class="flex flex-wrap gap-3 pt-2">
                <button
                  type="submit"
                  id="submitButton"
                  class="btn-stripe min-h-[48px] px-8 disabled:cursor-not-allowed disabled:opacity-60 focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/20"
                  aria-describedby="formStatus"
                >
                  Send message
                </button>

                <a
                  href={whatsappHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-stripe min-h-[48px] px-6"
                >
                  WhatsApp
                </a>
              </div>
          </form>

          <div class="mt-8 border-t border-border/80 pt-4">
            <div class="mb-4 font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground">
              Direct channels
            </div>
            <div class="grid gap-4">
              {quickChannels.map((channel) => (
                <a
                  href={channel.href}
                  target={channel.external ? '_blank' : undefined}
                  rel={channel.external ? 'noopener noreferrer' : undefined}
                  class="group grid gap-2 border-t border-border/80 pt-4 transition-colors hover:border-primary/35"
                >
                  <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground">
                    {channel.label}
                  </div>
                  <div class="flex items-center justify-between gap-4">
                    <span class="text-sm text-foreground">{channel.value}</span>
                    <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground transition-colors group-hover:text-foreground">
                      Open
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  const form = document.getElementById('contact-form');
  const formStatus = document.getElementById('formStatus');
  const errorMessage = formStatus?.querySelector('.error');
  const errorText = errorMessage?.querySelector('[data-error-text]');
  const successMessage = formStatus?.querySelector('.success');
  const loadingMessage = formStatus?.querySelector('.loading');
  const submitButton = document.getElementById('submitButton');

  const setBusy = (busy) => {
    if (submitButton) submitButton.disabled = busy;
    if (form) form.setAttribute('aria-busy', busy ? 'true' : 'false');
  };

  form?.addEventListener('submit', function (e) {
    e.preventDefault();

    setBusy(true);
    formStatus?.classList.remove('hidden');
    errorMessage?.classList.add('hidden');
    successMessage?.classList.add('hidden');
    loadingMessage?.classList.remove('hidden');

    const formData = new FormData(form);
    const object = Object.fromEntries(formData);

    fetch('/api/send-email', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Accept: 'application/json',
      },
      body: JSON.stringify(object),
    })
      .then(async (response) => {
        const json = await response.json().catch(() => ({}));
        if (response.ok && json.success) {
          loadingMessage?.classList.add('hidden');
          successMessage?.classList.remove('hidden');
          formStatus?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          form.reset();
        } else {
          throw new Error(json.error || 'There was an error sending your message. Please try again.');
        }
      })
      .catch((error) => {
        loadingMessage?.classList.add('hidden');
        if (errorText) errorText.textContent = error.message || 'There was an error sending your message. Please try again.';
        errorMessage?.classList.remove('hidden');
        formStatus?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      })
      .finally(() => {
        setBusy(false);
      });
  });
</script>
