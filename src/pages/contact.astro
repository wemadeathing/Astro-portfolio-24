---
export const prerender = true;
import Layout from '../layouts/Layout.astro';

const emailAddress = 'hello@nasifsalaam.com';
const whatsappHref = `https://wa.me/${['27', '81', '462', '3628'].join('')}?text=${encodeURIComponent("Hi! I'd like to discuss a project with you.")}`;
const responseTime = '24 hours';

const contactTracks = [
  {
    label: 'Hiring for a role',
    description: 'Senior or lead product design roles. Happy to jump on a call or answer questions by email first.',
  },
  {
    label: 'AI product or MVP',
    description: 'New builds, internal tools, rapid prototyping, or solo-to-team product work.',
  },
  {
    label: 'Product design + build',
    description: 'Systems, UX, interface design, and implementation in one joined-up thread.',
  },
  {
    label: 'High-trust website',
    description: 'Brand-led digital presence for businesses that need to look sharper and more credible.',
  },
];

const quickChannels = [
  { label: 'Email', value: emailAddress, href: `mailto:${emailAddress}?subject=${encodeURIComponent('New project enquiry')}` },
  { label: 'WhatsApp', value: 'Send a message', href: whatsappHref, external: true },
  { label: 'LinkedIn', value: 'nasifsalaam', href: 'https://www.linkedin.com/in/nasifsalaam/', external: true },
];

const agentMarkdown = `# Contact: Nasif Salaam

> Hiring for a product design role, or have a project in mind. Send a note and I will reply with next steps. Usually within ${responseTime}.

## Channels

- **Email:** ${emailAddress}
- **Calendly (30 min):** https://calendly.com/salaam-nasif/30min
- **LinkedIn:** https://www.linkedin.com/in/nasifsalaam/
- **Contact form:** https://nasifsalaam.com/contact/

## What to include

If reaching out about a role: the role, seniority, and remote/location expectations.
If reaching out about a project: what you are trying to build or solve, timeline, and budget range if you have one.`;
---

<Layout
  title="Contact | Nasif Salaam"
  description="Get in touch about a product design role, AI products, MVPs, or high-trust digital presence work."
  agentMarkdown={agentMarkdown}
  agentPathLabel="~/nasifsalaam / contact.md"
>
  <section class="py-10 sm:py-16">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">

      {/* ── Hero ── */}
      <div class="mb-12 border-b border-border/60 pb-12 scroll-reveal">
        <div class="section-kicker">Contact</div>
        <h1 class="type-h1 mt-4 max-w-[14ch]">Get in touch</h1>
        <p class="mt-5 max-w-[52ch] text-sm leading-[1.8] text-muted-foreground/88">
          Hiring for a product design role, or have a project in mind? Either way, send a note.
        </p>

        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {contactTracks.map((track, index) => (
            <div class="rounded-lg border border-border/80 p-4">
              <div class="mb-2 font-mono text-xs uppercase tracking-[0.18em] text-primary">0{index + 1}</div>
              <div class="text-sm font-semibold text-foreground leading-snug">{track.label}</div>
              <p class="mt-1.5 text-xs leading-[1.7] text-muted-foreground">{track.description}</p>
            </div>
          ))}
        </div>
      </div>

      {/* ── 2-col: form + sidebar ── */}
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_260px] lg:gap-16">

        {/* Form */}
        <div class="scroll-reveal scroll-reveal-d1">
          <div class="mb-6 font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">Send a note</div>

          <form
            id="contact-form"
            class="space-y-5"
            method="POST"
            aria-label="Contact form"
          >
            <div class="hidden" aria-hidden="true">
              <label for="company">Company</label>
              <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class="mb-2 block font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground">
                  Name
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  autocomplete="name"
                  placeholder="Your name"
                  class="w-full border border-border/80 bg-background px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground/50 focus:border-primary/60 focus:outline-none focus:ring-4 focus:ring-primary/12 transition-colors"
                  required
                />
              </div>

              <div>
                <label for="email" class="mb-2 block font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground">
                  Email
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  autocomplete="email"
                  inputmode="email"
                  placeholder="you@company.com"
                  class="w-full border border-border/80 bg-background px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground/50 focus:border-primary/60 focus:outline-none focus:ring-4 focus:ring-primary/12 transition-colors"
                  required
                />
              </div>
            </div>

            <div>
              <label for="message" class="mb-2 block font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground">
                Message
              </label>
              <textarea
                id="message"
                name="message"
                rows="7"
                placeholder="Tell me about the role or the project, and any timeline that matters."
                class="w-full resize-y border border-border/80 bg-background px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground/50 focus:border-primary/60 focus:outline-none focus:ring-4 focus:ring-primary/12 transition-colors"
                required
              ></textarea>
            </div>

            <div id="formStatus" class="hidden text-sm" role="status" aria-live="polite" aria-atomic="true">
              <p class="error hidden rounded-md border border-destructive/30 bg-destructive/15 px-4 py-3 text-destructive">
                <span class="sr-only">Error:</span>
                <span class="font-medium">⚠ </span>
                <span data-error-text>There was an error sending your message. Please try again.</span>
              </p>
              <p class="success hidden rounded-md border border-green-500/30 bg-green-500/15 px-4 py-3 text-green-400">
                <span class="sr-only">Success:</span>
                <span class="font-medium">✓ </span>
                Message sent successfully!
              </p>
              <p class="loading hidden rounded-md border border-primary/30 bg-primary/15 px-4 py-3 text-primary">
                <span class="sr-only">Loading:</span>
                <span class="animate-pulse">Sending message...</span>
              </p>
            </div>

            <div class="flex flex-wrap gap-3 pt-1">
              <button
                type="submit"
                id="submitButton"
                class="btn-stripe min-h-[44px] px-8 disabled:cursor-not-allowed disabled:opacity-60 focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/20"
                aria-describedby="formStatus"
              >
                Send message
              </button>
              <a
                href={whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-stripe min-h-[44px] px-6"
                data-tone="muted"
              >
                WhatsApp
              </a>
            </div>
          </form>
        </div>

        {/* Sidebar */}
        <aside class="scroll-reveal scroll-reveal-d2 flex flex-col gap-0 border-t border-border/60 pt-8 lg:border-t-0 lg:border-l lg:border-border/60 lg:pl-10 lg:pt-0">
          <div class="mb-6 font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">Direct channels</div>

          {quickChannels.map((channel) => (
            <a
              href={channel.href}
              target={channel.external ? '_blank' : undefined}
              rel={channel.external ? 'noopener noreferrer' : undefined}
              class="group flex items-center justify-between border-t border-border/60 py-4 transition-colors hover:border-primary/35"
            >
              <div>
                <div class="font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground mb-1">{channel.label}</div>
                <div class="text-sm text-foreground">{channel.value}</div>
              </div>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary opacity-0 transition-all group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0">
                <path d="M7 17L17 7"/><path d="M7 7h10v10"/>
              </svg>
            </a>
          ))}

          <div class="mt-6 border-t border-border/60 pt-6">
            <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground mb-2">Response time</div>
            <div class="text-sm text-foreground">Usually within {responseTime}</div>
          </div>

          <div class="mt-6 border-t border-border/60 pt-6">
            <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground mb-2">Based</div>
            <div class="text-sm text-foreground">Cape Town, South Africa</div>
            <div class="mt-1 text-xs text-muted-foreground">Available for remote projects worldwide</div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  const form = document.getElementById('contact-form');
  const formStatus = document.getElementById('formStatus');
  const errorMessage = formStatus?.querySelector('.error');
  const errorText = errorMessage?.querySelector('[data-error-text]');
  const successMessage = formStatus?.querySelector('.success');
  const loadingMessage = formStatus?.querySelector('.loading');
  const submitButton = document.getElementById('submitButton');

  const setBusy = (busy) => {
    if (submitButton) submitButton.disabled = busy;
    if (form) form.setAttribute('aria-busy', busy ? 'true' : 'false');
  };

  form?.addEventListener('submit', function (e) {
    e.preventDefault();

    setBusy(true);
    formStatus?.classList.remove('hidden');
    errorMessage?.classList.add('hidden');
    successMessage?.classList.add('hidden');
    loadingMessage?.classList.remove('hidden');

    const formData = new FormData(form);
    const object = Object.fromEntries(formData);

    fetch('/api/send-email', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(object),
    })
      .then(async (response) => {
        const json = await response.json().catch(() => ({}));
        if (response.ok && json.success) {
          loadingMessage?.classList.add('hidden');
          successMessage?.classList.remove('hidden');
          formStatus?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          form.reset();
        } else {
          throw new Error(json.error || 'There was an error sending your message. Please try again.');
        }
      })
      .catch((error) => {
        loadingMessage?.classList.add('hidden');
        if (errorText) errorText.textContent = error.message || 'There was an error sending your message. Please try again.';
        errorMessage?.classList.remove('hidden');
        formStatus?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      })
      .finally(() => {
        setBusy(false);
      });
  });
</script>
