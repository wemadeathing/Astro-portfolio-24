---
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((project) => project.data.published !== false)
    .map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

// For server-side rendering, get the project by slug
const { slug } = Astro.params;
let project: CollectionEntry<'projects'>;

if (Astro.props?.project) {
  // Static generation - use props
  project = Astro.props.project;
} else {
  // Server-side rendering - fetch by slug
  const projectEntry = await getEntry('projects', slug!);
  if (!projectEntry || projectEntry.data.published === false) {
    return Astro.redirect('/404');
  }
  project = projectEntry;
}

const { Content } = await project.render();

const showFeaturedImage = project.data.show_featured_image !== false;

const siteUrl = "https://nasifsalaam.com";
const shareUrl = new URL(Astro.url.pathname, siteUrl).href;

const projectSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CreativeWork",
      "name": project.data.title,
      "description": project.data.description,
      "image": project.data.image,
      "url": shareUrl,
      "creator": {
        "@type": "Person",
        "name": "Nasif Salaam",
        "url": "https://nasifsalaam.com"
      },
      "keywords": project.data.tags?.join(", ")
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://nasifsalaam.com/" },
        { "@type": "ListItem", "position": 2, "name": "Work", "item": "https://nasifsalaam.com/projects/" },
        { "@type": "ListItem", "position": 3, "name": project.data.title, "item": shareUrl }
      ]
    }
  ]
};

// Next-project navigation (wraps around, published only, grid order)
const allPublished = (await getCollection('projects'))
  .filter((p) => p.data.published !== false)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const currentIndex = allPublished.findIndex((p) => p.slug === project.slug);
const nextProject = allPublished[(currentIndex + 1) % allPublished.length];

// Client-color drench for the hero, falling back to the site's muted surface
const accent = project.data.accent ?? 'hsl(var(--muted))';
const accentFg = project.data.accentForeground ?? 'hsl(var(--foreground))';
const outcome = project.data.outcome ?? project.data.description;
const tldr = project.data.tldr;
const stats = project.data.stats;

const agentDivider = '---';
const liveLinksLine = project.data.links?.length
  ? `\n**Live:** ${project.data.links.map((l) => `[${l.label}](${l.url})`).join(' · ')}`
  : '';
const tldrBlock = tldr
  ? `\n\n**Problem:** ${tldr.problem}\n**Built:** ${tldr.built}\n**Result:** ${tldr.result}`
  : '';
const agentMarkdown = `# ${project.data.title}

> ${outcome}

**Tags:** ${(project.data.tags ?? []).join(', ')}
**URL:** ${shareUrl}${liveLinksLine}${tldrBlock}

${agentDivider}

${project.body}`;
---

<Layout
  title={project.data.title}
  description={project.data.description}
  image={project.data.image}
  schema={projectSchema}
  agentMarkdown={agentMarkdown}
  agentPathLabel={`~/nasifsalaam / projects / ${project.slug}.md`}
>
  <article class="min-h-screen bg-background" style={`--case-accent: ${accent}; --case-fg: ${accentFg};`}>

    <!-- Hero: drenched in the client's color. Negative margin cancels the
         page's default top padding so the color block sits flush under the nav. -->
    <section class="case-hero -mt-8 sm:-mt-10">
      <div class={`container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-10 ${showFeaturedImage && project.data.image ? 'case-hero-pad' : 'pb-14 sm:pb-20'}`}>
        <a href="/projects" class="case-back font-mono text-xs uppercase tracking-[0.12em]">
          &#8592; All work
        </a>
        <div class="case-kicker mt-10 font-mono text-xs uppercase tracking-[0.12em]">
          Case Study{project.data.tags?.[0] ? ` / ${project.data.tags[0]}` : ''}
        </div>
        <h1 class="case-title mt-5 max-w-[32ch]">
          {project.data.title.split(' - ')[0]}
        </h1>
        <p class="case-outcome mt-6 max-w-[48ch] text-base sm:text-lg leading-[1.7]">
          {outcome}
        </p>
        {project.data.links && project.data.links.length > 0 && (
          <div class="mt-8 flex flex-wrap items-center gap-3">
            {project.data.links.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="case-btn"
              >
                {link.label}
                <span aria-hidden="true" class="ml-2">&#8599;</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Featured image, overlapping the drench into the dark frame -->
    {showFeaturedImage && project.data.image && (
      <div class="container relative max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8 -mt-[clamp(40px,9vw,100px)]">
        <img
          src={project.data.image}
          alt={project.data.title}
          class="case-hero-img w-full aspect-video object-cover"
          loading="eager"
          decoding="async"
        />
      </div>
    )}

    <!-- Stats strip -->
    {stats && stats.length > 0 && (
      <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8 mt-10 sm:mt-14">
        <div class="grid grid-cols-2 border-y border-border/70 sm:grid-cols-4">
          {stats.slice(0, 4).map((stat, i) => (
            <div class={`py-5 sm:py-6 ${i > 0 ? 'sm:border-l sm:border-border/70 sm:pl-6' : ''} ${i % 2 === 1 ? 'border-l border-border/70 pl-5 sm:pl-6' : ''}`}>
              <div class="text-lg font-semibold text-foreground">{stat.value}</div>
              <div class="mt-1 font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- TLDR: the whole story in ten seconds -->
    {tldr && (
      <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8 mt-12 sm:mt-16">
        <div class="grid gap-8 lg:grid-cols-3 lg:gap-10">
          <div>
            <div class="font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">The problem</div>
            <p class="mt-3 text-base leading-[1.75] text-foreground/85">{tldr.problem}</p>
          </div>
          <div class="border-t border-border/60 pt-6 lg:border-t-0 lg:border-l lg:pl-10 lg:pt-0">
            <div class="font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">What I built</div>
            <p class="mt-3 text-base leading-[1.75] text-foreground/85">{tldr.built}</p>
          </div>
          <div class="border-t border-border/60 pt-6 lg:border-t-0 lg:border-l lg:pl-10 lg:pt-0">
            <div class="font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">The result</div>
            <p class="mt-3 text-base leading-[1.75] text-foreground/85">{tldr.result}</p>
          </div>
        </div>
      </div>
    )}

    <!-- Content -->
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8 mt-14 sm:mt-20 pb-4">
      <div class="prose max-w-none">
        <Content />
      </div>
    </div>

    <!-- CTA -->
    <section class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8 mt-16 sm:mt-20">
      <div class="border-y border-border/70 py-10 sm:py-14">
        <div class="section-kicker">Work with me</div>
        <h2 class="type-h2 mt-4 max-w-[22ch]">Want something like this for your business?</h2>
        <p class="mt-4 max-w-[52ch] text-sm leading-[1.8] text-muted-foreground/88">
          One person from brief to working product. Clear scope, honest timeline, and a fixed price after a free 30-minute call.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href="https://calendly.com/salaam-nasif/30min" target="_blank" rel="noopener noreferrer" class="btn-stripe min-h-[46px] px-7">
            Book a free call
          </a>
          <a href="/contact" class="btn-stripe min-h-[46px] px-7" data-tone="muted">
            Get in touch
          </a>
        </div>
      </div>
    </section>

    <!-- Next project -->
    {nextProject && nextProject.slug !== project.slug && (
      <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8 mt-4 pb-16 sm:pb-20">
        <a href={`/projects/${nextProject.slug}`} class="group grid items-center gap-6 py-8 sm:grid-cols-[1fr_260px]">
          <div>
            <div class="font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">Next project</div>
            <div class="mt-3 text-xl sm:text-2xl font-semibold text-foreground transition-colors group-hover:text-primary">
              {nextProject.data.title.split(' - ')[0]}
              <span aria-hidden="true" class="ml-2 inline-block transition-transform group-hover:translate-x-1">&#8594;</span>
            </div>
            <p class="mt-2 max-w-[52ch] text-sm leading-relaxed text-muted-foreground line-clamp-2">
              {nextProject.data.description}
            </p>
          </div>
          <div class="hidden overflow-hidden border border-border/70 sm:block">
            <img
              src={nextProject.data.image}
              alt={nextProject.data.title}
              class="aspect-[16/10] w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
              loading="lazy"
              decoding="async"
            />
          </div>
        </a>
      </div>
    )}
  </article>
</Layout>

<style is:global>
  /* Case study hero: drenched in the client's brand color */
  .case-hero {
    background: var(--case-accent);
    color: var(--case-fg);
  }

  .case-hero-pad {
    padding-bottom: clamp(90px, 16vw, 170px);
  }

  .case-back {
    color: color-mix(in srgb, var(--case-fg) 62%, transparent);
    transition: color 150ms ease;
  }

  .case-back:hover {
    color: var(--case-fg);
  }

  .case-kicker {
    color: color-mix(in srgb, var(--case-fg) 68%, transparent);
  }

  .case-title {
    color: var(--case-fg);
    font-size: 1.75rem;
    line-height: 1.15;
    font-weight: 650;
    letter-spacing: 0;
    text-wrap: balance;
  }

  @media (min-width: 640px) {
    .case-title {
      font-size: 2.125rem;
    }
  }

  @media (min-width: 1024px) {
    .case-title {
      font-size: 2.5rem;
    }
  }

  .case-outcome {
    color: color-mix(in srgb, var(--case-fg) 86%, transparent);
  }

  .case-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.5rem;
    border: 1px solid color-mix(in srgb, var(--case-fg) 45%, transparent);
    color: var(--case-fg);
    font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
  }

  .case-btn:hover {
    background: var(--case-fg);
    color: var(--case-accent);
    border-color: var(--case-fg);
  }

  .case-hero-img {
    border: 1px solid hsl(var(--border) / 0.7);
    background: hsl(var(--background));
  }

  /* Dark-first prose styles for project pages */
  .prose {
    @apply text-base leading-7 text-muted-foreground;
  }

  /* Showcase layout: text in a readable column, imagery and visual
     components span the full container width */
  .prose p,
  .prose ul,
  .prose ol,
  .prose h2,
  .prose h3,
  .prose h4,
  .prose blockquote {
    max-width: 70ch;
  }

  .prose > *:first-child {
    @apply mt-0;
  }

  .prose h2 {
    @apply mt-14 mb-5 border-t border-border/40 pt-5 text-2xl font-semibold scroll-mt-32 text-foreground;
  }

  .prose h3 {
    @apply mt-10 mb-3 text-xl font-semibold scroll-mt-32 text-foreground;
  }

  .prose h4 {
    @apply text-base font-medium text-muted-foreground scroll-mt-32;
  }

  .prose p {
    @apply mb-6 text-muted-foreground;
  }

  .prose ul {
    @apply my-6 list-none space-y-2;
  }

  .prose ul li {
    position: relative;
    padding-left: 1.25rem;
    @apply text-muted-foreground;
  }

  .prose ul li::before {
    content: "•";
    position: absolute;
    left: 0;
    top: 0;
    font-weight: 700;
    color: hsl(var(--foreground) / 0.9);
  }

  .prose img {
    @apply my-12 border border-border/80;
  }
  
  .prose figure {
    @apply my-14;
  }
  
  .prose figure img {
    @apply my-0;
  }
  
  .prose figcaption {
    @apply text-sm text-muted-foreground text-center mt-4 italic;
  }

  .prose blockquote {
    @apply my-10 py-3 pl-6 italic text-foreground/85;
    border-left: 3px solid var(--case-accent);
    background: color-mix(in srgb, var(--case-accent) 7%, transparent);
  }

  .prose blockquote p {
    @apply mb-0;
  }

  .prose blockquote strong {
    @apply not-italic text-foreground;
  }

  .prose table {
    @apply my-10 block w-full overflow-x-auto border-collapse text-sm;
  }

  .prose th {
    @apply border border-border/60 bg-muted/[0.04] px-4 py-3 text-left font-mono text-[10px] font-medium uppercase tracking-[0.14em] text-muted-foreground whitespace-nowrap;
  }

  .prose td {
    @apply border border-border/60 px-4 py-3 align-top text-muted-foreground;
  }

  .prose td:first-child {
    @apply font-medium text-foreground whitespace-nowrap;
  }

  .prose table strong {
    @apply text-foreground;
  }

  .prose pre {
    @apply my-10 overflow-x-auto border-y border-border/80 bg-black/20 px-0 py-6;
  }

  .prose code {
    @apply text-sm text-foreground/90;
  }

  .prose a {
    color: hsl(var(--primary));
    @apply underline decoration-2 underline-offset-2 transition-all;
    text-decoration-color: hsl(var(--primary) / 0.35);
  }

  .prose a:hover {
    text-decoration-color: hsl(var(--primary) / 0.95);
  }

  .prose strong {
    @apply text-foreground font-semibold;
  }

  .prose .not-prose .bg-card,
  .prose .not-prose [class*="bg-card"] {
    background: transparent !important;
    box-shadow: none !important;
  }

  .prose .not-prose [class*="bg-card"][class*="border"] {
    border-left: 0 !important;
    border-right: 0 !important;
    border-bottom: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  .prose .not-prose [class*="backdrop-blur"] {
    backdrop-filter: none !important;
  }

  .prose .not-prose .absolute.inset-0[class*="bg-gradient"] {
    opacity: 0.2;
  }

  .prose .not-prose .bg-blue-50,
  .prose .not-prose .text-blue-800 {
    background: transparent !important;
    color: hsl(var(--muted-foreground)) !important;
  }

  .prose .not-prose .border-blue-300 {
    border-color: hsl(var(--border)) !important;
  }

</style>
