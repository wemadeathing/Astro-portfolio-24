---
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((project) => project.data.published !== false)
    .map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

// For server-side rendering, get the project by slug
const { slug } = Astro.params;
let project: CollectionEntry<'projects'>;

if (Astro.props?.project) {
  // Static generation - use props
  project = Astro.props.project;
} else {
  // Server-side rendering - fetch by slug
  const projectEntry = await getEntry('projects', slug!);
  if (!projectEntry || projectEntry.data.published === false) {
    return Astro.redirect('/404');
  }
  project = projectEntry;
}

const { Content, headings } = await project.render();

const showSidebar = project.data.sidebar !== false;
const showFeaturedImage = project.data.show_featured_image !== false;

const siteUrl = "https://nasifsalaam.com";
const shareUrl = new URL(Astro.url.pathname, siteUrl).href;

const projectSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CreativeWork",
      "name": project.data.title,
      "description": project.data.description,
      "image": project.data.image,
      "url": shareUrl,
      "creator": {
        "@type": "Person",
        "name": "Nasif Salaam",
        "url": "https://nasifsalaam.com"
      },
      "keywords": project.data.tags?.join(", ")
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://nasifsalaam.com/" },
        { "@type": "ListItem", "position": 2, "name": "Work", "item": "https://nasifsalaam.com/projects/" },
        { "@type": "ListItem", "position": 3, "name": project.data.title, "item": shareUrl }
      ]
    }
  ]
};

const agentDivider = '---';
const agentMarkdown = `# ${project.data.title}

> ${project.data.description}

**Tags:** ${(project.data.tags ?? []).join(', ')}
**URL:** ${shareUrl}

${agentDivider}

${project.body}`;
---

<Layout
  title={project.data.title}
  description={project.data.description}
  image={project.data.image}
  schema={projectSchema}
  agentMarkdown={agentMarkdown}
  agentPathLabel={`~/nasifsalaam / projects / ${project.slug}.md`}
>
  <article class="min-h-screen bg-background">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 pb-16">
      <div class={showSidebar ? "grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_210px] gap-12 lg:gap-20" : ""}>
        <div class="min-w-0">
          <Breadcrumb 
            items={[
              { label: 'Home', href: '/' },
              { label: 'Work', href: '/projects' },
              { label: project.data.title }
            ]}
          />
          <!-- Header Section -->
          <header class="mb-14">
            <div class="shell-rule">
              <div class="section-kicker">Case Study</div>
              <h1 class="type-h1 mb-5 mt-4 max-w-[14ch]">
                {project.data.title}
              </h1>
            </div>
            <p class="type-lead mb-10 max-w-[62ch]">
              {project.data.description}
            </p>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
              {project.data.tags?.map((tag, index) => (
                <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground">
                  {index > 0 && <span class="mr-3 text-border/80">/</span>}
                  {tag}
                </span>
              ))}
            </div>
          </header>

          <!-- Featured Image -->
          {showFeaturedImage && project.data.image && (
            <div class="mb-18 border-y border-border/80 py-5">
              <img
                src={project.data.image}
                alt={project.data.title}
                class="w-full aspect-video object-cover"
                loading="lazy"
              />
            </div>
          )}
          
          <!-- Content -->
          <div class="prose max-w-none">
            <Content />
          </div>
        </div>

        <!-- Sidebar -->
        {showSidebar && (
          <aside class="hidden lg:block">
            <div class="sticky top-32 border-t border-border/80 pt-4">
              <div class="mb-4 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">On this page</div>
              <ul class="space-y-1 text-sm">
                {headings.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class="toc-link block py-1.5 text-muted-foreground transition-colors hover:text-foreground"
                      style={`margin-left: ${(heading.depth - 1) * 1}rem`}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )}
      </div>
    </div>
  </article>
</Layout>

<style is:global>
  /* Dark-first prose styles for project pages */
  .prose {
    @apply text-base leading-7 text-muted-foreground;
  }

  .prose > *:first-child {
    @apply mt-0;
  }

  .prose h2 {
    @apply mt-16 mb-5 border-t border-border/80 pt-6 text-2xl font-semibold scroll-mt-32 text-foreground;
  }

  .prose h3 {
    @apply mt-10 mb-3 text-xl font-semibold scroll-mt-32 text-foreground;
  }

  .prose h4 {
    @apply text-base font-medium text-muted-foreground scroll-mt-32;
  }

  .prose p {
    @apply mb-6 text-muted-foreground;
  }

  .prose ul {
    @apply my-6 list-none space-y-2;
  }

  .prose ul li {
    @apply flex items-start text-muted-foreground;
  }

  .prose ul li::before {
    content: "•";
    @apply mr-3 text-foreground/90 font-bold text-lg;
  }

  .prose img {
    @apply my-12 border border-border/80;
  }
  
  .prose figure {
    @apply my-14;
  }
  
  .prose figure img {
    @apply my-0;
  }
  
  .prose figcaption {
    @apply text-sm text-muted-foreground text-center mt-4 italic;
  }

  .prose blockquote {
    @apply my-10 border-y border-border/80 py-5 italic text-muted-foreground;
  }

  .prose pre {
    @apply my-10 overflow-x-auto border-y border-border/80 bg-black/20 px-0 py-6;
  }

  .prose code {
    @apply text-sm text-foreground/90;
  }

  .prose a {
    color: hsl(var(--primary));
    @apply underline decoration-2 underline-offset-2 transition-all;
    text-decoration-color: hsl(var(--primary) / 0.35);
  }

  .prose a:hover {
    text-decoration-color: hsl(var(--primary) / 0.95);
  }

  .prose strong {
    @apply text-foreground font-semibold;
  }

  .prose .not-prose .bg-card,
  .prose .not-prose [class*="bg-card"] {
    background: transparent !important;
    box-shadow: none !important;
  }

  .prose .not-prose [class*="bg-card"][class*="border"] {
    border-left: 0 !important;
    border-right: 0 !important;
    border-bottom: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  .prose .not-prose [class*="backdrop-blur"] {
    backdrop-filter: none !important;
  }

  .prose .not-prose .absolute.inset-0[class*="bg-gradient"] {
    opacity: 0.2;
  }

  .prose .not-prose .bg-blue-50,
  .prose .not-prose .text-blue-800 {
    background: transparent !important;
    color: hsl(var(--muted-foreground)) !important;
  }

  .prose .not-prose .border-blue-300 {
    border-color: hsl(var(--border)) !important;
  }

  /* Enhanced TOC styling */
  .toc-link {
    transition: all 0.2s ease-in-out;
    position: relative;
  }

  .toc-link.active {
    color: hsl(var(--foreground));
    font-weight: 500;
  }
</style>

<script>
  // Active section highlighting (project detail) - ViewTransitions-safe
  const initProjectToc = () => {
    const tocLinks = Array.from(document.querySelectorAll('.toc-link')) as HTMLAnchorElement[];
    const headings = Array.from(document.querySelectorAll('.prose h2, .prose h3')) as HTMLElement[];
    if (!tocLinks.length || !headings.length) return;

    const updateActiveToc = () => {
      let activeHeading: HTMLElement | null = null;
      for (const heading of headings) {
        const rect = heading.getBoundingClientRect();
        if (rect.top <= 140) activeHeading = heading;
      }

      tocLinks.forEach((link) => link.classList.remove('active'));
      if (activeHeading?.id) {
        const activeLink = document.querySelector(`a[href="#${activeHeading.id}"]`);
        if (activeLink) activeLink.classList.add('active');
      }
    };

    const onScroll = (() => {
      let ticking = false;
      return () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          updateActiveToc();
          ticking = false;
        });
      };
    })();

    const w = window as any;
    if (w.__projectTocOnScroll) window.removeEventListener('scroll', w.__projectTocOnScroll);
    w.__projectTocOnScroll = onScroll;
    window.addEventListener('scroll', onScroll, { passive: true });

    updateActiveToc();
  };

  initProjectToc();
  document.addEventListener('astro:page-load', initProjectToc);
</script>
