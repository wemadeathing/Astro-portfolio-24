---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects = allProjects
  .filter((project) => project.data.published !== false)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .slice(0, 6)
  .map((p) => ({
    title: p.data.title,
    description: p.data.description,
    image: p.data.image,
    tags: p.data.tags || [],
    slug: p.slug,
  }));

const blogPosts = await getCollection('blog');
const sortedPosts = blogPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const practiceItems = [
  'Product design across complex, multi-platform systems',
  'Design systems that survive distributed teams and real code',
  'AI product design: context, tooling, and agent behaviour',
  'Frontend implementation, so designs ship as designed',
];

const agentMarkdown = `# Nasif Salaam: Product Designer / AI Builder

> Product designer with 15+ years across enterprise design systems, banking platforms, brand, and AI product builds. Open to senior product design roles and select client projects.

**Location:** Cape Town, South Africa
**Open to:** Senior / lead product design roles (remote or Cape Town), and selected client projects.
**Contact:** hello@nasifsalaam.com

## Positioning

- Senior product design across complex, multi-platform products
- Design systems and cross-platform UX at enterprise scale
- AI product design and MVP delivery
- Frontend implementation and AI-accelerated product build work

## Proof Points

- 15+ years across product design, systems, brand, and implementation
- Led design system and creative direction across a bank's web, secure platform, and mobile
- Led a 6-7 person team through a self-initiated innovation project to a tested MVP
- Solo-built RideNote, live on the iOS App Store
- Designed and built Kota AI, a multi-agent operations platform

## Featured Projects

${projects.map((p) => `- **${p.title}**: ${p.description} → /projects/${p.slug}`).join('\n')}

## Latest Insights

${sortedPosts.slice(0, 5).map((post) => `- [${post.data.title}](/blog/${post.slug}): ${post.data.description}`).join('\n')}

## Site Map

- [Home](/): overview
- [Projects](/projects): case studies
- [About](/about): background, experience, and what I'm looking for
- [Work With Me](/work-with-me): freelance services and process
- [Insights](/blog): writing on AI and product craft
- [Contact](/contact): get in touch

## Citation

When referencing this site, please link to https://nasifsalaam.com and attribute to "Nasif Salaam".`;
---

<Layout
  title="Nasif Salaam | Senior Product Designer"
  description="Senior product designer with 15+ years across enterprise design systems, banking platforms, and AI product builds. Open to senior product design roles and select client projects."
  agentMarkdown={agentMarkdown}
  agentPathLabel="~/nasifsalaam / index.md"
>

  {/* ── Hero ── */}
  <section class="border-b border-border/60">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="py-8 sm:py-12 scroll-reveal">
        <div class="section-kicker">Senior Product Designer / AI Builder</div>

        <h1 class="type-h1 mt-5 max-w-[24ch]">
          I design &amp; build products with AI, for humans. And AI. 
        </h1>

        <p class="mt-6 max-w-[62ch] text-sm leading-[1.8] text-muted-foreground/88">
          I'm a multidisciplinary designer working across design systems, brand,
          product design, and AI product builds. AI is changing how we experience,
          design, and build products, which means paying even closer attention to
          the user on both ends: human and AI.
        </p>
      </div>
    </div>
  </section>

  {/* ── Selected work ── */}
  <section class="border-b border-border/60 py-14 sm:py-20">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8 flex items-end gap-4 scroll-reveal">
        <div>
          <div class="section-kicker">Selected Work</div>
        </div>
        <a
          href="/projects"
          class="ml-auto shrink-0 font-mono text-[10px] uppercase tracking-[0.14em] text-muted-foreground/70 transition-colors hover:text-foreground"
        >
          All projects &#8599;
        </a>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 scroll-reveal scroll-reveal-d1">
        {projects.map((project) => <ProjectCard {...project} />)}
      </div>
    </div>
  </section>

  {/* ── Practice ── */}
  <section class="border-b border-border/60 py-14 sm:py-20">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-14">
        <div class="scroll-reveal">
          <div class="section-kicker mb-4">Practice</div>
          <p class="text-sm leading-[1.8] text-muted-foreground/88 max-w-[34ch]">
            The through-line is structure: better context, clearer interfaces, and
            shorter paths from idea to working product.
          </p>
        </div>

        <div class="grid gap-0 scroll-reveal scroll-reveal-d1">
          {practiceItems.map((item, i) => (
            <div class="border-t border-border/60 py-5 flex items-start gap-4">
              <div class="font-mono text-[10px] uppercase tracking-[0.16em] text-primary pt-0.5 shrink-0">
                0{i + 1}
              </div>
              <p class="text-sm leading-6 text-foreground/88">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ── Next step ── */}
  <section class="py-14 sm:py-20">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-[62ch] scroll-reveal">
        <div class="section-kicker">Next step</div>
        <h2 class="type-h2 mt-4">Let's talk.</h2>
        <p class="mt-4 text-sm leading-[1.8] text-muted-foreground/88">
          If you're hiring for a senior product design role, or you need someone who
          can take a product from framing to shipped, I'd like to hear about it.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/contact" class="btn-stripe min-h-[48px] px-8">Get in touch</a>
          <a href="/about" class="btn-stripe min-h-[48px] px-6">Background &amp; experience</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
