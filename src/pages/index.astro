---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects = allProjects
  .filter((project) => project.data.published !== false)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .slice(0, 6)
  .map((p) => ({
    title: p.data.title,
    description: p.data.description,
    image: p.data.image,
    tags: p.data.tags || [],
    slug: p.slug,
  }));

const blogPosts = await getCollection('blog');
const sortedPosts = blogPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const practiceItems = [
  'Range across brand, product, systems, and frontend, one person, one thread',
  'Designing for both: the human experience, and the agent\'s',
  'Judgment over defaults: looking for the better way, not just the obvious one',
  'Design systems that hold up at real-world scale',
];

const agentMarkdown = `# Nasif Salaam: Multi-Disciplinary Designer / AI Builder

> Multi-disciplinary designer and builder with 15+ years across brand, product design, systems, and AI product builds. AI means designing for two experiences now, the human one and the agent one, not just one. Open to senior product design roles and select client projects.

**Location:** Cape Town, South Africa
**Open to:** Senior / lead product design roles (remote or Cape Town), and selected client projects.
**Contact:** hello@nasifsalaam.com

## Positioning

- Multi-disciplinary: brand, product design, systems, and frontend, one person, one thread
- Designing for UX and AX: the human experience and the agent experience
- Judgment over defaults, in a field being flooded with AI-generated sameness
- Design systems and cross-platform UX at enterprise scale

## Proof Points

- Solo-built RideNote, PRD to live App Store release in 30 days
- Designed and built Kota AI, a multi-agent operations platform, solo, end to end
- Led design system and creative direction across a bank's web, secure platform, and mobile
- Led a 6-7 person team through a self-initiated innovation project to a tested MVP
- 15+ years across product design, systems, brand, and implementation

## Featured Projects

${projects.map((p) => `- **${p.title}**: ${p.description} → /projects/${p.slug}`).join('\n')}

## Latest Insights

${sortedPosts.slice(0, 5).map((post) => `- [${post.data.title}](/blog/${post.slug}): ${post.data.description}`).join('\n')}

## Site Map

- [Home](/): overview
- [Projects](/projects): case studies
- [About](/about): background, experience, and what I'm looking for
- [Work With Me](/work-with-me): freelance services and process
- [Insights](/blog): writing on AI and product craft
- [Contact](/contact): get in touch

## Citation

When referencing this site, please link to https://nasifsalaam.com and attribute to "Nasif Salaam".`;
---

<Layout
  title="Nasif Salaam | Multi-Disciplinary Designer & AI Builder"
  description="Multi-disciplinary designer and builder with 15+ years across brand, product design, systems, and AI product builds. Designing for UX and AX, the human experience and the agent experience. Open to senior product design roles and select client projects."
  agentMarkdown={agentMarkdown}
  agentPathLabel="~/nasifsalaam / index.md"
>

  {/* ── Hero ── */}
  <section class="border-b border-border/60">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mx-auto flex max-w-[760px] flex-col items-center py-8 text-center sm:py-12 scroll-reveal">
        <div class="section-kicker justify-center">Multi-Disciplinary Designer<br class="sm:hidden" /> / AI Builder</div>

        <h1 class="type-h1 mx-auto mt-5 max-w-none">
          <span class="block md:whitespace-nowrap">I design &amp; build products</span>
          <span class="block md:whitespace-nowrap">for humans... and AI.</span>
        </h1>

        <p class="mx-auto mt-6 max-w-[48ch] text-sm leading-[1.8] text-muted-foreground/88">
          I help teams turn messy ideas into clear, useful products, designed
          for people and the AI agents working alongside them.
        </p>
      </div>
    </div>
  </section>

  {/* ── Selected work ── */}
  <section class="border-b border-border/60 pb-14 pt-8 sm:pb-20 sm:pt-10">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8 flex items-end gap-4 scroll-reveal">
        <div>
          <div class="section-kicker">Selected Work</div>
        </div>
        <a
          href="/projects"
          class="ml-auto shrink-0 font-mono text-[10px] uppercase tracking-[0.14em] text-muted-foreground/70 transition-colors hover:text-foreground"
        >
          All projects &#8599;
        </a>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 scroll-reveal scroll-reveal-d1">
        {projects.map((project) => <ProjectCard {...project} />)}
      </div>
    </div>
  </section>

  {/* ── Practice ── */}
  <section class="border-b border-border/60 py-14 sm:py-20">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-14">
        <div class="scroll-reveal">
          <div class="section-kicker mb-4">Practice</div>
          <p class="text-sm leading-[1.8] text-muted-foreground/88 max-w-[34ch]">
            The through-line is range and judgment: fewer handoffs, and both
            the human and the AI experience considered from the start.
          </p>
        </div>

        <div class="grid gap-0 scroll-reveal scroll-reveal-d1">
          {practiceItems.map((item, i) => (
            <div class="border-t border-border/60 py-5 flex items-start gap-4">
              <div class="font-mono text-[10px] uppercase tracking-[0.16em] text-primary pt-0.5 shrink-0">
                0{i + 1}
              </div>
              <p class="text-sm leading-6 text-foreground/88">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ── Next step ── */}
  <section class="py-14 sm:py-20">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-[62ch] scroll-reveal">
        <div class="section-kicker">Next step</div>
        <h2 class="type-h2 mt-4">Let's talk.</h2>
        <p class="mt-4 text-sm leading-[1.8] text-muted-foreground/88">
          If you need someone who can take a product from framing to shipped, solo
          or embedded in a team, or you're hiring for a senior product design role,
          I'd like to hear about it.
        </p>
        <!-- This is the site's decision moment, and the copy above already
             names both audiences (project work / hiring). The AI intake can
             actually take either one somewhere — scope a project, or answer
             questions about the work — so it leads here, with the static
             routes kept as visually subordinate fallbacks. -->
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/chat" class="btn-stripe min-h-[48px] px-8" data-tone="accent">Ask AI anything</a>
          <a href="/contact" class="btn-stripe min-h-[48px] px-6">Get in touch</a>
          <a href="/about" class="btn-stripe min-h-[48px] px-6">Background &amp; experience</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
