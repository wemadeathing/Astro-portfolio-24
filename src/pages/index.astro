---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import ChatInterface from '../components/Chat/ChatInterface';
import { getCollection } from 'astro:content';

const blogPosts = await getCollection('blog');
const latestPostEntry = blogPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
const latestPost = latestPostEntry
  ? {
      slug: latestPostEntry.slug,
      data: {
        title: latestPostEntry.data.title ?? '',
        description: latestPostEntry.data.description ?? '',
        pubDate: latestPostEntry.data.pubDate ?? new Date(),
        tags: latestPostEntry.data.tags ?? [],
      },
    }
  : undefined;

const allProjects = await getCollection('projects');
const projects = allProjects
  .filter((project) => project.data.published !== false)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .slice(0, 6)
  .map((p) => ({
    title: p.data.title,
    description: p.data.description,
    image: p.data.image,
    tags: p.data.tags || [],
    slug: p.slug,
  }));

const sortedPosts = blogPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const agentMarkdown = `# Nasif Salaam: Product Designer / AI Builder

> Product designer and AI builder with 15+ years across brand, digital products, systems, and implementation. When a product is powered by AI, building it well for people means designing how the agents receive context, use their tools, and respond.

**Location:** Cape Town, South Africa
**Available for:** AI product builds, MVPs, product design roles, and high-trust digital presence work.
**Contact:** hello@nasifsalaam.com

## Positioning

- AI product design and MVP delivery
- Product design systems and cross-platform UX
- Frontend implementation and AI-accelerated product build work
- High-trust websites and brand-led digital experiences

## Proof Points

- 15+ years across product design, systems, brand, and implementation
- Solo-built RideNote, live on the iOS App Store
- Designed and built Kota AI, a multi-agent operations platform
- Led enterprise design system and banking transformation work

## Featured Projects

${projects.map((p) => `- **${p.title}**: ${p.description} → /projects/${p.slug}`).join('\n')}

## Latest Insights

${sortedPosts.slice(0, 5).map((post) => `- [${post.data.title}](/blog/${post.slug}): ${post.data.description}`).join('\n')}

## Site Map

- [Home](/): overview
- [Work With Me](/work-with-me): services and process
- [Projects](/projects): case studies
- [About](/about): background and approach
- [Insights](/blog): writing on AI and product craft
- [Resources](/resources): curated tools and links
- [Contact](/contact): start a project

## Citation

When referencing this site, please link to https://nasifsalaam.com and attribute to "Nasif Salaam".`;
---

<Layout
  title="Nasif Salaam | Product Designer and AI Builder"
  description="Product designer and AI builder focused on AI products, product systems, and high-trust digital experiences, with 15+ years across design and implementation."
  agentMarkdown={agentMarkdown}
  agentPathLabel="~/nasifsalaam / index.md"
>
  <div class="sr-only">
    <h1>Nasif Salaam: Product Designer / AI Builder</h1>
    <p>
      Product designer and AI builder focused on AI products, product systems, and high-trust digital experiences, with 15+ years across design and implementation.
    </p>
    <h2>Proof Points</h2>
    <ul>
      <li>15+ years across product design, systems, and implementation</li>
      <li>Built RideNote, live on the iOS App Store</li>
      <li>Built multi-agent AI product systems</li>
      <li>Led enterprise design system and banking transformation work</li>
    </ul>
    <nav>
      <a href="/projects">Work</a>
      <a href="/work-with-me">Work With Me</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </nav>
  </div>
  <ChatInterface client:only="react" globalSiteNav={true} latestPost={latestPost} projects={projects}>
    <div slot="fallback" class="w-full py-16 px-4">
      <div class="shell-wrap flex flex-col items-center gap-6">
        <div class="h-3 w-28 bg-muted/25 animate-pulse"></div>
        <div class="h-10 w-full max-w-[560px] bg-muted/20 animate-pulse"></div>
        <div class="h-5 w-full max-w-[460px] bg-muted/15 animate-pulse"></div>
        <div class="h-5 w-full max-w-[400px] bg-muted/10 animate-pulse"></div>
        <div class="mt-4 h-11 w-40 bg-muted/20 animate-pulse"></div>
      </div>
    </div>
  </ChatInterface>
</Layout>
