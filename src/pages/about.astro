---
export const prerender = true;
import Layout from '../layouts/Layout.astro';

const heroHighlights = [
  '15+ years across brand, UX, UI, and frontend delivery',
  'Enterprise systems, founder builds, and AI-native product work',
  'Trust, clarity, and execution without the handoff gaps',
];

const expertise = [
  {
    title: 'AI Products, MVPs, and AI-Accelerated Build Work',
    description: `I take product ideas from framing to working software, combining product design, system thinking, and implementation. When a product is AI-powered, that means designing how the agents receive context, use their tools, and respond, in service of the person using it. Recent examples include Kota AI, a multi-agent SME platform, and RideNote, a solo-built iOS app live on the App Store.`,
  },
  {
    title: 'Product Systems and Cross-Platform UX',
    description: `I have spent 15+ years designing digital products across banking, retail, property, and tech. I am strongest where structure matters: product systems, scalable UI, complex journeys, and work that has to earn user trust.`,
  },
  {
    title: 'High-Trust Digital Presence',
    description: `I also design and build brand-led websites for businesses that need to look credible fast. That includes identity work, web design, and implementation for service businesses, founders, and small teams.`,
  },
];

const skills = [
  {
    title: 'What I can do',
    items: [
      'End-to-end product design, research to launch',
      'UI/UX for web and mobile',
      'Design systems',
      'Brand identity',
      'Frontend implementation',
      'AI product builds',
      'Designing how AI agents receive context and use tools',
    ],
  },
  {
    title: 'What I work with',
    items: [
      'React, Astro, Tailwind, TypeScript',
      'Figma, Adobe Creative Suite, Affinity',
      'Claude, Cursor, Claude Code',
      'PostgreSQL, WordPress, APIs',
    ],
  },
  {
    title: 'How I work',
    items: [
      'End to end, without handoff gaps',
      'AI-accelerated workflows',
      'Close collaboration with dev teams',
      'Agile delivery, Git-based',
      'User research and usability testing',
    ],
  },
];

const industry = [
  {
    title: 'Financial Services',
    items: ['ABSA', 'Bidvest Bank', 'Old Mutual', 'Standard Bank'],
  },
  {
    title: 'Retail & Consumer',
    items: ['Clicks', 'Musica', 'PEP', 'Shoprite', 'Checkers', "Sportsman's Warehouse"],
  },
  {
    title: 'Property & Real Estate',
    items: ['Rabie Property Group', 'Signatûra'],
  },
  {
    title: 'Technology & SaaS',
    items: ['EverPrompt', 'FindMeACoffee', 'Micro apps'],
  },
  {
    title: 'Small Business',
    items: ['Travel', 'Hospitality', 'Events', 'FMCG', 'Services'],
  },
];

const certifications = [
  { name: 'ISO/IEC 42001:2023 Lead Auditor', issuer: 'Mastermind Assurance', year: '2026' },
  { name: 'AI Security & Governance', issuer: 'Securiti', year: '2025' },
  { name: 'AI Fluency', issuer: 'Anthropic', year: '2025' },
  { name: 'Introduction to Generative AI', issuer: 'Google Cloud', year: '2024' },
];

const experience = [
  {
    role: 'Product Designer / AI Builder',
    company: 'Independent',
    period: '2025 - Present',
    description: `Project-based client work across brand identity, web design, and frontend development, managing projects end to end from brief through to delivery. Built custom websites and digital assets for clients across various industries. Also built Kota AI (a multi-agent business operations platform designed and built end-to-end) and RideNote (iOS App Store live, Android in testing), using AI-accelerated workflows to build complex products fast.`,
  },
  {
    role: 'Lead Designer',
    company: 'Immersion Group',
    period: '2022 - 2024 | Remote',
    description: `Banking suite development across mobile, web, and dashboard. Led design system creation spanning three product streams. Delivered rapid innovation projects for Old Mutual and ABSA using FlutterFlow and Supabase. Initiated and led internal innovation program with cross-functional team of 6 throughout 2024.`,
  },
  {
    role: 'Senior Web Designer',
    company: 'Machete Creative',
    period: '2019 - 2022 | Cape Town',
    description: `Brand identity design from concept to completion, WordPress development and customization, responsive web design for multi-property real estate portfolio. Collaborated directly with development teams on website solutions and digital assets.`,
  },
  {
    role: 'Freelance Designer',
    company: 'Self-employed',
    period: '2014 - 2018',
    description: `Brand identity, digital design, and marketing collateral for clients across travel, hospitality, events, FMCG, and service industries. Built responsive websites and handled end-to-end design projects.`,
  },
  {
    role: 'Senior Graphic Designer',
    company: 'Musica & Clicks',
    period: '2009 - 2012',
    description: `In-house design for retail marketing materials, promotional campaigns, and brand assets across multiple product lines.`,
  },
];

const agentMarkdown = `# About: Nasif Salaam

> Product designer and AI builder focused on AI products, product systems, and high-trust digital experiences. Fifteen plus years across design and implementation.

## Current Focus

Project-based client work across brand identity, web design, and frontend development. Building **Kota AI** (multi-agent business operations platform, designed and built end-to-end) and **RideNote** (iOS App Store live, Android in testing). Open to product design / AI build roles and to project work.

## Expertise

${expertise.map((e) => `### ${e.title}\n${e.description}`).join('\n\n')}

## Skills

${skills.map((s) => `### ${s.title}\n${s.items.map((i) => `- ${i}`).join('\n')}`).join('\n\n')}

## Industries

${industry.map((i) => `- **${i.title}:** ${i.items.join(', ')}`).join('\n')}

## Experience

${experience.map((e) => `### ${e.role}, ${e.company} (${e.period})\n${e.description}`).join('\n\n')}

## Contact

- Email: hello@nasifsalaam.com
- LinkedIn: https://www.linkedin.com/in/nasifsalaam/
- Site: https://nasifsalaam.com`;
---

<Layout
  title="About | Product Designer and AI Builder"
  description="Product designer and AI builder focused on AI products, product systems, and high-trust digital experiences, with 15+ years across design and implementation."
  agentMarkdown={agentMarkdown}
  agentPathLabel="~/nasifsalaam / about.md"
>
  <section class="py-10 sm:py-14">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1.1fr)_320px] lg:gap-16">
        <div>
          <div class="">
            <div class="section-kicker">About</div>
            <h1 class="type-h1 mt-4">
              Product Designer / AI Builder
            </h1>
          </div>
          <div class="mt-5 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">
            AI products • Product systems • High-trust digital experiences
          </div>
          <p class="mt-6 max-w-[64ch] text-base leading-[1.8] text-muted-foreground sm:text-lg">
            I help teams and founders turn complexity into clear digital products. My background spans enterprise design systems, banking transformation, client websites, and solo-built AI products, which means I can move between strategy, interface, and implementation without losing the thread. And when a product is powered by AI, building it well for people means designing how the agents receive context, use their tools, and respond, not just the human interface.
          </p>

          <p class="mt-6 inline-flex items-center gap-2 border-t border-border/80 pt-4 font-mono text-[11px] uppercase tracking-[0.14em] text-foreground">
            <span class="h-2 w-2 bg-primary"></span>
            Open to product design / AI build roles and to project work.
          </p>

          <div class="mt-10 grid gap-4 sm:grid-cols-3">
            {heroHighlights.map((item, index) => (
              <div class="border-t border-border/80 pt-4">
                <div class="mb-2 font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground">
                  0{index + 1}
                </div>
                <p class="text-sm leading-6 text-muted-foreground">
                  {item}
                </p>
              </div>
            ))}
          </div>
        </div>

        <aside class="grid gap-4 lg:pt-10">
          <div class="grid gap-4">
            <div class="border-t border-border/80 pt-4">
              <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Based</div>
              <div class="mt-2 text-sm text-foreground">Cape Town, South Africa</div>
            </div>
            <div class="border-t border-border/80 pt-4">
              <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Best Fit</div>
              <div class="mt-2 text-sm leading-6 text-muted-foreground">AI product builds, product design systems, high-trust digital presence, and MVP delivery.</div>
            </div>
            <div class="border-t border-border/80 pt-4">
              <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Working Style</div>
              <div class="mt-2 text-sm leading-6 text-muted-foreground">Strategy, interface, and implementation held together in one line of thinking.</div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
    <section id="now" class="py-12 sm:py-14 scroll-mt-28">
      <div class="max-w-[62ch]">
        <div class="section-kicker">Where I’m strongest</div>
        <h2 class="type-h2 mt-4">The work I’m best suited for</h2>
        <p class="mt-4 text-sm sm:text-base leading-[1.75] text-muted-foreground">
          Three lanes, one underlying strength: translating complexity into something people can understand, trust, and use.
        </p>
      </div>

      <div class="mt-10 grid gap-8 stagger-children">
        {expertise.map((item, index) => (
          <div class="grid gap-4 border-t border-border/80 pt-5 lg:grid-cols-[72px_minmax(0,280px)_minmax(0,1fr)] lg:gap-8">
            <div class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">
              0{index + 1}
            </div>
            <h3 class="text-lg font-semibold text-foreground sm:text-xl">{item.title}</h3>
            <p class="text-sm sm:text-base leading-[1.75] text-muted-foreground">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <section id="capabilities" class="py-12 sm:py-14 scroll-mt-28">
      <div class="max-w-[56ch]">
        <div class="section-kicker">Capabilities</div>
        <h2 class="type-h2 mt-4">How the work shows up</h2>
        <p class="mt-4 text-sm sm:text-base leading-[1.75] text-muted-foreground">
          Three views of the same practice: what I can do, what I work with, and how I work.
        </p>
      </div>

      <div class="mt-10 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 stagger-children">
        {skills.map((group) => (
          <div class="border-t border-border/80 pt-4">
            <div class="mb-3 font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground">{group.title}</div>
            <p class="text-sm leading-[1.85] text-muted-foreground">
              {group.items.join(' • ')}
            </p>
          </div>
        ))}
      </div>
    </section>

    <section class="py-12 sm:py-14">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)] lg:gap-16">
        <div id="industry" class="scroll-mt-28">
          <div class="section-kicker mb-3">Selected contexts</div>
          <h2 class="type-h2">Industry range</h2>
          <p class="mt-4 max-w-[56ch] text-sm sm:text-base leading-[1.75] text-muted-foreground">
            Different sectors, same job underneath: reduce complexity, earn trust, and make the interface carry its weight.
          </p>

          <div class="mt-8 grid gap-6 sm:grid-cols-2 stagger-children">
            {industry.map((group) => (
              <div class="border-t border-border/80 pt-4">
                <div class="mb-3 font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground">{group.title}</div>
                <p class="text-sm leading-[1.85] text-muted-foreground">
                  {group.items.join(', ')}
                </p>
              </div>
            ))}
          </div>
        </div>

        <div id="certifications" class="scroll-mt-28">
          <div class="section-kicker mb-3">Credentials</div>
          <h2 class="type-h2">Certifications</h2>

          <div class="mt-8 space-y-4 stagger-children">
            {certifications.map((cert) => (
              <div class="grid gap-2 border-t border-border/80 pt-4 sm:grid-cols-[1fr_auto] sm:items-start">
                <div>
                  <div class="text-sm font-semibold text-foreground">{cert.name}</div>
                  <div class="mt-1 text-xs text-muted-foreground">{cert.issuer}</div>
                </div>
                <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground">
                  {cert.year}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="career" class="py-12 sm:py-14 scroll-mt-28">
      <div class="max-w-[62ch]">
        <div class="section-kicker">Proof</div>
        <h2 class="type-h2 mt-4">Professional journey</h2>
        <p class="mt-4 text-sm sm:text-base leading-[1.75] text-muted-foreground">
          The titles changed over time, but the through-line stayed the same: design that can survive contact with real constraints.
        </p>
      </div>

      <div class="mt-10 grid gap-2 stagger-children">
        {experience.map((item) => (
          <div class="grid gap-4 border-t border-border/80 py-5 lg:grid-cols-[200px_220px_minmax(0,1fr)] lg:gap-8">
            <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground">
              {item.period}
            </div>
            <div>
              <h3 class="text-lg font-semibold text-foreground">{item.role}</h3>
              {item.company && <p class="mt-1 text-sm text-muted-foreground">{item.company}</p>}
            </div>
            <div>
              <p class="max-w-[72ch] text-sm sm:text-base leading-[1.75] text-muted-foreground">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="pb-14 pt-6 sm:pb-20 sm:pt-10">
      <div class="max-w-[68ch]">
        <div class="section-kicker">Next step</div>
        <h2 class="type-h2 mt-4">
          Let’s build something useful.
        </h2>
        <p class="mt-4 text-base sm:text-lg leading-[1.75] text-muted-foreground">
          If you need someone who can move between product design, systems, and implementation without losing clarity, let’s connect.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/contact" class="btn-stripe">
            Let’s Connect
          </a>
          <a href="/Nasif-Salaam-Resume.pdf" download class="btn-stripe">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Download Resume
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
