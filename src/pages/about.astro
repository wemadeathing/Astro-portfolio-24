---
export const prerender = true;
import Layout from '../layouts/Layout.astro';

const expertise = [
  {
    title: 'AI Products, MVPs, and AI-Accelerated Build Work',
    description: `I take product ideas from framing to working software, combining product design, system thinking, and implementation. When a product is AI-powered, that means designing how the agents receive context, use their tools, and respond, in service of the person using it. Recent examples include Kota AI, a multi-agent SME platform, and RideNote, a solo-built iOS app live on the App Store.`,
  },
  {
    title: 'Product Systems and Cross-Platform UX',
    description: `I have spent 15+ years designing digital products across banking, retail, property, and tech. I am strongest where structure matters: product systems, scalable UI, complex journeys, and work that has to earn user trust.`,
  },
  {
    title: 'High-Trust Digital Presence',
    description: `I also design and build brand-led websites for businesses that need to look credible fast. That includes identity work, web design, and implementation for service businesses, founders, and small teams.`,
  },
];

const skills = [
  {
    title: 'What I can do',
    items: [
      'End-to-end product design',
      'Design systems',
      'Brand identity',
      'Frontend implementation',
      'AI product builds',
    ],
  },
  {
    title: 'What I work with',
    items: [
      'React, Astro, Tailwind, TypeScript',
      'Figma, Adobe CC, Affinity',
      'Claude, Cursor, Claude Code',
      'PostgreSQL, WordPress, APIs',
      'LangChain, Resend, Supabase, OpenRouter',
    ],
  },
  {
    title: 'How I work',
    items: [
      'End to end, no handoff gaps',
      'AI-accelerated workflows',
      'Close collaboration with devs',
      'Agile, Git-based delivery',
      'User research + usability testing',
    ],
  },
];

const allSectors = [
  'ABSA', 'Bidvest Bank', 'Old Mutual', 'Standard Bank',
  'Clicks', 'Musica', 'PEP', 'Shoprite', 'Checkers', "Sportsman's Warehouse",
  'Rabie Property Group', 'Signatûra',
  'EverPrompt', 'FindMeACoffee', 'Micro apps',
  'Travel', 'Hospitality', 'Events', 'FMCG', 'Services',
];

const certifications = [
  { name: 'ISO/IEC 42001:2023 Lead Auditor', issuer: 'Mastermind Assurance', year: '2026' },
  { name: 'AI Security & Governance', issuer: 'Securiti', year: '2025' },
  { name: 'AI Fluency', issuer: 'Anthropic', year: '2025' },
  { name: 'Introduction to Generative AI', issuer: 'Google Cloud', year: '2024' },
];

const experience = [
  {
    role: 'Product Designer / AI Builder',
    company: 'Independent',
    period: '2025 - Present',
    description: `Project-based client work across brand identity, web design, and frontend development, managing projects end to end from brief through to delivery. Built custom websites and digital assets for clients across various industries. Also built Kota AI (a multi-agent business operations platform designed and built end-to-end) and RideNote (iOS App Store live, Android in testing), using AI-accelerated workflows to build complex products fast.`,
  },
  {
    role: 'Lead Designer',
    company: 'Immersion Group',
    period: '2022 - 2024 | Remote',
    description: `Banking suite development across mobile, web, and dashboard. Led design system creation spanning three product streams. Delivered rapid innovation projects for Old Mutual and ABSA using FlutterFlow and Supabase. Initiated and led internal innovation program with cross-functional team of 6 throughout 2024.`,
  },
  {
    role: 'Senior Web Designer',
    company: 'Machete Creative',
    period: '2019 - 2022 | Cape Town',
    description: `Brand identity design from concept to completion, WordPress development and customization, responsive web design for multi-property real estate portfolio. Collaborated directly with development teams on website solutions and digital assets.`,
  },
  {
    role: 'Freelance Designer',
    company: 'Self-employed',
    period: '2014 - 2018',
    description: `Brand identity, digital design, and marketing collateral for clients across travel, hospitality, events, FMCG, and service industries. Built responsive websites and handled end-to-end design projects.`,
  },
  {
    role: 'Senior Graphic Designer',
    company: 'Musica & Clicks',
    period: '2009 - 2012',
    description: `In-house design for retail marketing materials, promotional campaigns, and brand assets across multiple product lines.`,
  },
];

const agentMarkdown = `# About: Nasif Salaam

> Product designer and AI builder focused on AI products, product systems, and high-trust digital experiences. Fifteen plus years across design and implementation.

## Current Focus

Project-based client work across brand identity, web design, and frontend development. Building **Kota AI** (multi-agent business operations platform, designed and built end-to-end) and **RideNote** (iOS App Store live, Android in testing). Open to product design / AI build roles and to project work.

## Expertise

${expertise.map((e) => `### ${e.title}\n${e.description}`).join('\n\n')}

## Skills

${skills.map((s) => `### ${s.title}\n${s.items.map((i) => `- ${i}`).join('\n')}`).join('\n\n')}

## Experience

${experience.map((e) => `### ${e.role}, ${e.company} (${e.period})\n${e.description}`).join('\n\n')}

## Contact

- Email: hello@nasifsalaam.com
- LinkedIn: https://www.linkedin.com/in/nasifsalaam/
- Site: https://nasifsalaam.com`;
---

<Layout
  title="About | Product Designer and AI Builder"
  description="Product designer and AI builder focused on AI products, product systems, and high-trust digital experiences, with 15+ years across design and implementation."
  agentMarkdown={agentMarkdown}
  agentPathLabel="~/nasifsalaam / about.md"
>

  {/* ── Hero ── */}
  <section class="py-10 sm:py-16">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1.2fr)_280px] lg:gap-20">
        <div class="reveal">
          <div class="section-kicker">About</div>
          <h1 class="type-h1 mt-4">Product Designer<br />/ AI Builder</h1>
          <p class="mt-6 max-w-[60ch] text-sm leading-[1.8] text-muted-foreground/88">
            I help teams and founders turn complexity into clear digital products. My background spans enterprise design systems, banking transformation, client websites, and solo-built AI products — which means I can move between strategy, interface, and implementation without losing the thread.
          </p>
          <p class="mt-5 inline-flex items-center gap-2.5 font-mono text-[11px] uppercase tracking-[0.14em] text-foreground">
            <span class="h-1.5 w-1.5 bg-primary"></span>
            Open to product design / AI build roles and to project work.
          </p>
        </div>

        <aside class="reveal reveal-d2 flex flex-col gap-0 lg:pt-2 border-t border-border/60 lg:border-t-0 lg:border-l lg:border-border/60 lg:pl-10">
          <div class="border-b border-border/60 py-5 first:pt-0 lg:first:pt-5">
            <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted-foreground/70 mb-1.5">Based</div>
            <div class="text-sm text-foreground">Cape Town, South Africa</div>
          </div>
          <div class="border-b border-border/60 py-5">
            <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted-foreground/70 mb-1.5">Best Fit</div>
            <div class="text-sm leading-[1.8] text-muted-foreground/88">AI product builds, design systems, high-trust digital presence, MVP delivery.</div>
          </div>
          <div class="py-5">
            <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted-foreground/70 mb-1.5">Working Style</div>
            <div class="text-sm leading-[1.8] text-muted-foreground/88">Strategy, interface, and implementation held together in one line of thinking.</div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {/* ── Expertise ── */}
  <section class="border-t border-border/60 py-14 sm:py-20">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12 reveal">
        <div class="section-kicker">Where I'm strongest</div>
        <h2 class="type-h2 mt-4 max-w-[28ch]">The work I'm best suited for</h2>
      </div>

      <div class="grid gap-0">
        {expertise.map((item, index) => (
          <div class={`reveal reveal-d${index + 1} grid border-t border-border/60 py-8 gap-6 lg:grid-cols-[64px_minmax(0,1fr)_minmax(0,1.4fr)] lg:gap-12 lg:py-10 items-start`}>
            <div class="font-mono text-3xl font-bold text-primary/40 leading-none tabular-nums">
              0{index + 1}
            </div>
            <h3 class="text-base font-semibold text-foreground leading-snug">
              {item.title}
            </h3>
            <p class="text-sm leading-[1.8] text-muted-foreground/88">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Capabilities ── */}
  <section class="border-t border-border/60 bg-muted/[0.035] py-14 sm:py-20">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12 reveal">
        <div class="section-kicker">Capabilities</div>
        <h2 class="type-h2 mt-4 max-w-[24ch]">How the work shows up</h2>
      </div>

      <div class="grid gap-5 sm:grid-cols-3">
        {skills.map((group, index) => (
          <div class={`reveal reveal-d${index + 1} flex flex-col border border-border/80 p-5`}>
            <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-primary mb-4">{group.title}</div>
            <ul class="flex flex-col gap-2">
              {group.items.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-muted-foreground leading-snug">
                  <span class="mt-[0.35em] h-1 w-1 shrink-0 bg-border"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Industry ── */}
  <section class="border-t border-border/60 py-14 sm:py-20">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10 reveal">
        <div class="section-kicker">Selected contexts</div>
        <h2 class="type-h2 mt-4 max-w-[24ch]">Industry range</h2>
        <p class="mt-4 max-w-[52ch] text-sm leading-[1.8] text-muted-foreground/88">
          Different sectors, same job underneath: reduce complexity, earn trust, and make the interface carry its weight.
        </p>
      </div>

      <div class="reveal reveal-d1 flex flex-wrap gap-2">
        {allSectors.map((sector) => (
          <span class="border border-border/70 px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.1em] text-muted-foreground">
            {sector}
          </span>
        ))}
      </div>
    </div>
  </section>

  {/* ── Certifications carousel ── */}
  <section class="border-t border-border/60 bg-muted/[0.035] py-14 sm:py-20 overflow-hidden">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8 mb-10">
      <div class="reveal">
        <div class="section-kicker">Credentials</div>
        <h2 class="type-h2 mt-4">Certifications</h2>
      </div>
    </div>

    <div class="cert-track-outer reveal reveal-d1">
      <div class="cert-track">
        {[...certifications, ...certifications].map((cert, i) => (
          <div class="cert-card border border-border/80 bg-background p-6 shrink-0">
            <div class="font-mono text-[10px] uppercase tracking-[0.16em] text-primary mb-3">{cert.year}</div>
            <div class="text-sm font-semibold text-foreground leading-snug mb-1.5">{cert.name}</div>
            <div class="text-xs text-muted-foreground">{cert.issuer}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Proof (career) ── */}
  <section id="career" class="border-t border-border/60 py-14 sm:py-20 scroll-mt-28">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-[62ch] mb-10 reveal">
        <div class="section-kicker">Proof</div>
        <h2 class="type-h2 mt-4">Professional journey</h2>
        <p class="mt-4 text-sm leading-[1.8] text-muted-foreground/88">
          The titles changed over time, but the through-line stayed the same: design that can survive contact with real constraints.
        </p>
      </div>

      <div class="grid gap-2">
        {experience.map((item, index) => (
          <div class={`reveal reveal-d${Math.min(index + 1, 5)} grid gap-4 border-t border-border/60 py-6 lg:grid-cols-[200px_220px_minmax(0,1fr)] lg:gap-8`}>
            <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground">
              {item.period}
            </div>
            <div>
              <h3 class="text-base font-semibold text-foreground">{item.role}</h3>
              {item.company && <p class="mt-1 text-xs text-muted-foreground">{item.company}</p>}
            </div>
            <p class="text-sm leading-[1.8] text-muted-foreground/88">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Next step ── */}
  <section class="border-t border-border/60 pb-16 pt-12 sm:pb-24 sm:pt-16">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-[68ch] reveal">
        <div class="section-kicker">Next step</div>
        <h2 class="type-h2 mt-4">Let's build something useful.</h2>
        <p class="mt-4 text-sm leading-[1.8] text-muted-foreground/88">
          If you need someone who can move between product design, systems, and implementation without losing clarity, let's connect.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/contact" class="btn-stripe">Let's Connect</a>
          <a href="/Nasif-Salaam-Resume.pdf" download class="btn-stripe">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Download Resume
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .cert-track-outer {
    width: 100%;
    overflow: hidden;
    cursor: grab;
  }
  .cert-track-outer:active {
    cursor: grabbing;
  }
  .cert-track {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    padding: 0 2rem;
    animation: cert-scroll 36s linear infinite;
  }
  .cert-track:hover {
    animation-play-state: paused;
  }
  .cert-card {
    width: 300px;
  }
  @keyframes cert-scroll {
    from { transform: translateX(0) }
    to   { transform: translateX(-50%) }
  }
</style>
