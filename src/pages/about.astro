---
export const prerender = true;
import Layout from '../layouts/Layout.astro';

const expertise = [
  {
    title: 'AI Products, MVPs, and Agent Experience Design',
    description: `I take product ideas from framing to working software, combining product design, systems thinking, and implementation. When a product is AI-powered, there's UX and there's AX: how the agents receive context, use their tools, and respond, in service of the person using it. Recent examples include Kota AI, a multi-agent SME platform, and RideNote, a solo-built iOS app live on the App Store.`,
  },
  {
    title: 'Product Systems and Cross-Platform UX',
    description: `I have spent 15+ years designing digital products across banking, retail, property, and tech. I am strongest where structure matters: product systems, scalable UI, complex journeys, and work that has to earn user trust.`,
  },
  {
    title: 'High-Trust Digital Presence',
    description: `I also design and build brand-led websites for businesses that need to look credible. That includes identity work, web design, and implementation for service businesses, founders, and small teams.`,
  },
];

/* What I'm looking for: the block that tells a hiring manager whether to bother.
   TODO(nasif): edit these to match what you actually want. Being specific here
   filters out bad-fit approaches and makes good-fit ones far more likely. */
const lookingFor = [
  {
    label: 'Role',
    value: 'Senior or Lead Product Designer, though titles matter less to me than scope. I want ownership of a product area, and room to move across design, build, and AI, not a narrow lane.',
  },
  {
    label: 'Team',
    value: 'A team that ships and measures, interested in innovation, that values progress and improving its systems.',
  },
  {
    label: 'Location',
    value: 'Remote (any timezone with reasonable overlap), or on-site in Cape Town.',
  },
  {
    label: 'Problems',
    value: 'Products where structure and visual execution matter: design systems, multi-platform journeys, AI-powered tools, anything that has to earn user trust.',
  },
];

const skills = [
  {
    title: 'What I can do',
    items: [
      'End-to-end product design',
      'Design systems',
      'Brand identity',
      'Frontend implementation',
      'AI product builds',
    ],
  },
  {
    title: 'What I work with',
    items: [
      'React, Astro, Tailwind, TypeScript',
      'Figma, Adobe CC, Affinity',
      'Claude, Cursor, Claude Code',
      'PostgreSQL, WordPress, APIs',
      'LangChain, Resend, Supabase, OpenRouter',
    ],
  },
  {
    title: 'How I work',
    items: [
      'AI-native design and development workflows',
      'Close collaboration with devs',
      'Agile, Git-based delivery',
      'User research + usability testing',
    ],
  },
];

const allSectors = [
  'ABSA', 'Bidvest Bank', 'Old Mutual',
  'Clicks', 'Musica', 'PEP', 'Shoprite', 'Checkers', "Sportsman's Warehouse",
  'Rabie Property Group', 'Signatûra',
  'FindMeACoffee', 'Micro apps',
  'Travel', 'Hospitality', 'Events', 'Services',
];

const certifications = [
  { name: 'ISO/IEC 42001:2023 Lead Auditor', issuer: 'Mastermind Assurance', year: '2026' },
  { name: 'AIQI ISO/IEC 42001', issuer: 'UKAS', year: '2025' },
  { name: 'AI Security & Governance', issuer: 'Securiti', year: '2025' },
  { name: 'AI Fluency', issuer: 'Anthropic', year: '2025' },
  { name: 'Introduction to Generative AI', issuer: 'Google Cloud', year: '2024' },
];

const experience = [
  {
    role: 'Product Designer / AI Builder',
    company: 'Independent',
    period: '2025 - Present',
    description: `Project-based client work across brand identity, web design, and frontend development, managing projects end to end from brief through to delivery. Built custom websites and digital assets for clients across various industries. Also built Kota AI (a multi-agent business operations platform designed and built end-to-end) and RideNote (iOS App Store live, Android in testing), designing for both the people using these products and the AI agents working inside them.`,
  },
  {
    role: 'Lead Designer',
    company: 'Immersion Group',
    period: '2022 - 2024 | Remote',
    description: `Banking suite development across mobile, web, and dashboard. Led design system creation spanning three product streams. Delivered rapid innovation projects for Old Mutual and ABSA using FlutterFlow and Supabase. Initiated and led internal innovation program with cross-functional team of 6 throughout 2024.`,
  },
  {
    role: 'Senior Web Designer',
    company: 'Machete Creative',
    period: '2019 - 2022 | Cape Town',
    description: `Brand identity design from concept to completion, WordPress development and customization, responsive web design for multi-property real estate portfolio. Collaborated directly with development teams on website solutions and digital assets.`,
  },
  {
    role: 'Freelance Designer',
    company: 'Self-employed',
    period: '2014 - 2018',
    description: `Brand identity, digital design, and marketing collateral for clients across travel, hospitality, events, FMCG, and service industries. Built responsive websites and handled end-to-end design projects.`,
  },
  {
    role: 'Senior Graphic Designer',
    company: 'Musica & Clicks',
    period: '2009 - 2012',
    description: `In-house design for retail marketing materials, promotional campaigns, and brand assets across multiple product lines.`,
  },
];

const agentMarkdown = `# About: Nasif Salaam

> Multi-disciplinary designer and builder with 15+ years across brand, product design, systems, and AI product builds, not a narrow specialist. AI means designing for two experiences now, UX and AX, the human one and the agent one.

## Availability

**Open to senior or lead product design roles**, remote, or on-site in Cape Town. Also taking on select client projects.

${lookingFor.map((l) => `- **${l.label}:** ${l.value}`).join('\n')}

## Current Focus

Building **Kota AI** (multi-agent business operations platform, designed and built end-to-end) and **RideNote** (live on the iOS App Store, Android in testing), alongside project-based client work across brand identity, web design, and frontend development.

## Expertise

${expertise.map((e) => `### ${e.title}\n${e.description}`).join('\n\n')}

## Skills

${skills.map((s) => `### ${s.title}\n${s.items.map((i) => `- ${i}`).join('\n')}`).join('\n\n')}

## Experience

${experience.map((e) => `### ${e.role}, ${e.company} (${e.period})\n${e.description}`).join('\n\n')}

## Contact

- Email: hello@nasifsalaam.com
- LinkedIn: https://www.linkedin.com/in/nasifsalaam/
- Site: https://nasifsalaam.com`;
---

<Layout
  title="About | Multi-Disciplinary Designer, Open to Work"
  description="Multi-disciplinary designer and builder with 15+ years across brand, product design, systems, and AI product builds. Designing for UX and AX, the human experience and the agent experience. Open to senior product design roles, remote or Cape Town."
  agentMarkdown={agentMarkdown}
  agentPathLabel="~/nasifsalaam / about.md"
>

  {/* ── Hero ── */}
  <section class="py-10 sm:py-16">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1.2fr)_280px] lg:gap-20">
        <div class="scroll-reveal">
          <div class="section-kicker">About</div>
          <h1 class="type-h1 mt-4">Multi-Disciplinary Designer<br />/ AI Builder</h1>
          <p class="mt-6 max-w-[60ch] text-sm leading-[1.8] text-muted-foreground/88">
            I work across disciplines: brand, product design, systems, and code, rather than staying in one lane. That range spans enterprise design systems and banking transformation through to solo-built AI products. And when a product is powered by AI, there's no longer just UX to design for. There's AX too: how the agents receive context, use their tools, and respond. As more of what ships is AI-generated and starts to look the same, holding onto the human experience is the part that actually takes judgment.
          </p>
          {/* Availability: leads with employment, keeps the freelance door open */}
          <div class="mt-7 border border-border/80 p-5 max-w-[60ch]">
            <p class="inline-flex items-center gap-2.5 font-mono text-[11px] uppercase tracking-[0.14em] text-foreground">
              <span class="h-1.5 w-1.5 bg-primary"></span>
              Open to work
            </p>
            <p class="mt-3 text-sm leading-[1.8] text-muted-foreground/88">
              Looking for a <strong class="text-foreground font-semibold">senior or lead product design role</strong>,
              remote, or on-site in Cape Town. Also taking on select client projects.
            </p>
            <div class="mt-5 flex flex-wrap gap-3">
              <a href="/contact" class="btn-stripe">Get in touch</a>
              <a href="/Nasif-Salaam-Resume.pdf" download class="btn-stripe">Download CV</a>
            </div>
          </div>
        </div>

        <aside class="scroll-reveal scroll-reveal-d2 flex flex-col gap-0 lg:pt-2 border-t border-border/60 lg:border-t-0 lg:border-l lg:border-border/60 lg:pl-10">
          <div class="border-b border-border/60 py-5 first:pt-0 lg:first:pt-5">
            <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted-foreground/70 mb-1.5">Based</div>
            <div class="text-sm text-foreground">Cape Town, South Africa</div>
          </div>
          <div class="border-b border-border/60 py-5">
            <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted-foreground/70 mb-1.5">Seeking</div>
            <div class="text-sm leading-[1.8] text-muted-foreground/88">Senior / lead product design roles. Remote, or Cape Town.</div>
          </div>
          <div class="border-b border-border/60 py-5">
            <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted-foreground/70 mb-1.5">Best Fit</div>
            <div class="text-sm leading-[1.8] text-muted-foreground/88">Teams that need one person across design, build, and AI, thinking about the human experience and the agent experience both. Design systems and MVP delivery both fit.</div>
          </div>
          <div class="py-5">
            <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted-foreground/70 mb-1.5">Working Style</div>
            <div class="text-sm leading-[1.8] text-muted-foreground/88">Strategy, interface, and implementation held together in one line of thinking.</div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {/* ── What I'm looking for ── */}
  <section class="border-t border-border/60 bg-muted/[0.035] py-14 sm:py-20">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10 scroll-reveal">
        <div class="section-kicker">Open to work</div>
        <h2 class="type-h2 mt-4 max-w-[28ch]">What I'm looking for</h2>
      </div>

      <div class="grid gap-0 max-w-[80ch]">
        {lookingFor.map((item, index) => (
          <div class={`scroll-reveal scroll-reveal-d${index + 1} grid gap-2 border-t border-border/60 py-6 lg:grid-cols-[160px_minmax(0,1fr)] lg:gap-10`}>
            <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-primary pt-1">
              {item.label}
            </div>
            <p class="text-sm leading-[1.8] text-muted-foreground/88">{item.value}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Expertise ── */}
  <section class="border-t border-border/60 py-14 sm:py-20">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12 scroll-reveal">
        <div class="section-kicker">Where I'm strongest</div>
        <h2 class="type-h2 mt-4 max-w-[28ch]">The work I'm best suited for</h2>
      </div>

      <div class="grid gap-0">
        {expertise.map((item, index) => (
          <div class={`scroll-reveal scroll-reveal-d${index + 1} grid border-t border-border/60 py-8 gap-6 lg:grid-cols-[64px_minmax(0,1fr)_minmax(0,1.4fr)] lg:gap-12 lg:py-10 items-start`}>
            <div class="font-mono text-3xl font-bold text-primary/40 leading-none tabular-nums">
              0{index + 1}
            </div>
            <h3 class="text-base font-semibold text-foreground leading-snug">
              {item.title}
            </h3>
            <p class="text-sm leading-[1.8] text-muted-foreground/88">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Capabilities ── */}
  <section class="border-t border-border/60 bg-muted/[0.035] py-14 sm:py-20">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12 scroll-reveal">
        <div class="section-kicker">Capabilities</div>
        <h2 class="type-h2 mt-4 max-w-[24ch]">How the work shows up</h2>
      </div>

      <div class="grid gap-5 sm:grid-cols-3">
        {skills.map((group, index) => (
          <div class={`scroll-reveal scroll-reveal-d${index + 1} flex flex-col border border-border/80 p-5`}>
            <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-primary mb-4">{group.title}</div>
            <ul class="flex flex-col gap-2">
              {group.items.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-muted-foreground leading-snug">
                  <span class="mt-[0.35em] h-1 w-1 shrink-0 bg-border"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Industry ── */}
  <section class="border-t border-border/60 py-14 sm:py-20">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10 scroll-reveal">
        <div class="section-kicker">Selected contexts</div>
        <h2 class="type-h2 mt-4 max-w-[24ch]">Industry range</h2>
        <p class="mt-4 max-w-[52ch] text-sm leading-[1.8] text-muted-foreground/88">
          Different sectors, same job underneath: reduce complexity, earn trust, and make the interface carry its weight.
        </p>
      </div>

      <div class="scroll-reveal scroll-reveal-d1 flex flex-wrap gap-2">
        {allSectors.map((sector) => (
          <span class="border border-border/70 px-3 py-1.5 font-mono text-xs uppercase tracking-[0.1em] text-muted-foreground">
            {sector}
          </span>
        ))}
      </div>
    </div>
  </section>

  {/* ── Certifications ── */}
  <section class="border-t border-border/60 py-14 sm:py-20 scroll-reveal">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 divide-y sm:divide-y-0 sm:divide-x divide-border/60">
        {certifications.map((cert, i) => (
          <div class="py-8 sm:py-0 sm:px-8 first:pl-0 last:pr-0">
            <div class="font-mono text-xs tracking-[0.18em] text-primary mb-4">
              0{i + 1}
            </div>
            <div class="font-mono text-sm uppercase tracking-[0.1em] font-semibold text-foreground leading-snug mb-3">
              {cert.name}
            </div>
            <div class="font-mono text-xs tracking-[0.1em] text-muted-foreground/70">
              {cert.issuer} · {cert.year}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Proof (career) ── */}
  <section id="career" class="border-t border-border/60 py-14 sm:py-20 scroll-mt-28">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-[62ch] mb-10 scroll-reveal">
        <div class="section-kicker">Proof</div>
        <h2 class="type-h2 mt-4">Professional journey</h2>
        <p class="mt-4 text-sm leading-[1.8] text-muted-foreground/88">
          The titles changed over time, but the through-line stayed the same: design that can survive contact with real constraints.
        </p>
      </div>

      <div class="grid gap-2">
        {experience.map((item, index) => (
          <div class={`scroll-reveal scroll-reveal-d${Math.min(index + 1, 5)} grid gap-4 border-t border-border/60 py-6 lg:grid-cols-[200px_220px_minmax(0,1fr)] lg:gap-8`}>
            <div class="font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground">
              {item.period}
            </div>
            <div>
              <h3 class="text-base font-semibold text-foreground">{item.role}</h3>
              {item.company && <p class="mt-1 text-sm text-muted-foreground">{item.company}</p>}
            </div>
            <p class="text-sm leading-[1.8] text-muted-foreground/88">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Next step ── */}
  <section class="border-t border-border/60 pb-16 pt-12 sm:pb-24 sm:pt-16">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-[68ch] scroll-reveal">
        <div class="section-kicker">Next step</div>
        <h2 class="type-h2 mt-4">Let's talk.</h2>
        <p class="mt-4 text-sm leading-[1.8] text-muted-foreground/88">
          If you need someone who can move between product design, systems, and
          implementation without losing clarity, or you're hiring for a senior
          product design role, I'd like to hear from you.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/contact" class="btn-stripe">Let's Connect</a>
          <a href="/Nasif-Salaam-Resume.pdf" download class="btn-stripe">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Download Resume
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .cert-track-outer {
    width: 100%;
    overflow: hidden;
    cursor: grab;
  }
  .cert-track-outer:active {
    cursor: grabbing;
  }
  .cert-track {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    padding: 0 2rem;
    animation: cert-scroll 36s linear infinite;
  }
  .cert-track:hover {
    animation-play-state: paused;
  }
  .cert-card {
    width: 300px;
  }
  @keyframes cert-scroll {
    from { transform: translateX(0) }
    to   { transform: translateX(-50%) }
  }
</style>
