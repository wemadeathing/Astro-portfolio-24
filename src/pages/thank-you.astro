---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---

<Layout title="Thank You | Message Sent" robots="noindex, nofollow">
  <section class="py-12 sm:py-16">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center stagger-children">
      <div class="mb-8 flex justify-center">
        <div class="border border-primary/30 bg-primary/12 p-4">
          <svg 
            xmlns="http://www.w3.org/2000/svg" 
            class="h-12 w-12 text-primary"
            viewBox="0 0 24 24" 
            fill="none" 
            stroke="currentColor" 
            stroke-width="2"
          >
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        </div>
      </div>
      
      <h1 class="type-h1 mb-6 text-foreground">Thank You!</h1>
      <p class="type-lead mb-12">
        Your message has been sent successfully. I'll get back to you as soon as possible.
      </p>
      
      <a
        href="/"
        class="btn-stripe"
      >
        Back to Home
      </a>
      </div>
    </div>
  </section>
</Layout>
