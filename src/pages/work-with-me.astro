---
export const prerender = true;
import Layout from '../layouts/Layout.astro';

const services = [
  {
    number: '01',
    label: 'High-Trust Digital Presence',
    heading: 'Brand-led websites that make a business feel credible fast.',
    body: "I design and build websites and supporting brand systems for businesses that need to look established, clear, and trustworthy. This is a good fit when the offer is strong but the current digital presence is making the business feel smaller than it is.",
    includes: [
      'New websites from scratch',
      'Brand identity: logo, colours, typography',
      'Redesigns and refreshes',
    ],
    audience: 'Service businesses, founders, and small teams that need a sharper digital presence to support outreach, trust, and lead generation.',
    image: '/images/work-with-me-01.png',
    imageAlt: 'Website and brand identity design by Nasif Salaam',
  },
  {
    number: '02',
    label: 'AI Products, MVPs & Product Design',
    heading: 'From concept to working product, without the usual handoff gaps.',
    body: "I work across product framing, UX, system thinking, interface design, and implementation to get products moving quickly. When the product is AI-powered, that includes designing how the agents inside it receive context, use their tools, and respond, so it works for the person using it. This is the stronger fit when you need an MVP, an internal AI tool, or someone who can bridge product design and build.",
    includes: [
      'Web and mobile MVPs',
      'AI-powered product builds',
      'Full stack: design to deployment',
    ],
    audience: 'Founders, product teams, and innovation leads who need a design-minded builder to move from idea to working software.',
    image: '/images/work-with-me-02.png',
    imageAlt: 'Product and MVP development by Nasif Salaam',
  },
];

const steps = [
  {
    number: '1',
    title: 'We talk',
    description: "Book a free 30-minute call. Tell me what you need. I'll tell you honestly whether I'm the right person to help.",
  },
  {
    number: '2',
    title: 'I put a plan together',
    description: "Based on our conversation, I'll come back with a clear scope, timeline, and price. No vague proposals.",
  },
  {
    number: '3',
    title: 'We build it',
    description: "I get to work. You stay in the loop. Most projects move fast. I'm not the kind of person who disappears for weeks.",
  },
  {
    number: '4',
    title: "You've got something real",
    description: "Whether it's a website, a product, or a refreshed brand, you walk away with something that works.",
  },
];

const calLink = 'https://calendly.com/salaam-nasif/30min';
const emailAddress = 'hello@nasifsalaam.com';

const agentMarkdown = `# Work With Me: Nasif Salaam

> Product designer and AI builder focused on AI products, MVPs, and high-trust digital experiences. I help with both product builds and the digital presence that makes them credible.

## Services

${services
  .map(
    (s, idx) => `### ${idx + 1}. ${s.label}

**${s.heading}**

${s.body}

**Includes:**
${s.includes.map((i) => `- ${i}`).join('\n')}

**Best for:** ${s.audience}`
  )
  .join('\n\n')}

## Process

${steps.map((s) => `${s.number}. **${s.title}**: ${s.description}`).join('\n')}

## Get Started

- Book a 30-minute call: ${calLink}
- Email: ${emailAddress}
- Site: https://nasifsalaam.com`;
---

<Layout
  title="Work With Me | Nasif Salaam"
  description="Work with Nasif Salaam on AI products, MVPs, product design, and high-trust digital presence projects."
  agentMarkdown={agentMarkdown}
  agentPathLabel="~/nasifsalaam / work-with-me.md"
  image="/images/work-with-me-01.png"
>
  <section class="py-10 sm:py-14">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-[70ch] reveal">
        <div class="">
          <div class="section-kicker">Work With Me</div>
          <h1 class="type-h1 mt-4">
            Product design, AI build work, and digital presence that earns trust.
          </h1>
        </div>
        <p class="mt-6 text-sm leading-[1.8] text-muted-foreground/88">
          I work in two lanes: AI products and MVPs that need to get real quickly, and high-trust websites or brand-led digital experiences for businesses that need to look as strong as they are.
        </p>
        <p class="mt-4 max-w-[58ch] text-sm leading-[1.8] text-muted-foreground/88">
          Product designer / AI builder, with enough implementation depth to keep the work moving and enough design judgment to keep it coherent. Open to project work and to full-time roles.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={calLink} target="_blank" rel="noopener noreferrer" class="btn-stripe">
            Book a free 30-minute call
          </a>
          <a href={`mailto:${emailAddress}`} class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground transition-colors hover:text-foreground">
            {emailAddress}
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
    <section id="services" class="py-12 sm:py-14 scroll-mt-28">
      <div class="max-w-[58ch]">
        <div class="section-kicker">Services</div>
        <h2 class="type-h2 mt-4">Where I can help most</h2>
        <p class="mt-4 text-sm leading-[1.8] text-muted-foreground/88">
          Two kinds of work, one underlying advantage: product thinking, interface craft, and implementation kept in one thread.
        </p>
      </div>

      <div class="mt-10 grid gap-12">
        {services.map((service, i) => (
          <div class={`reveal reveal-d${i + 1} grid gap-6 border-t border-border/80 pt-5 lg:grid-cols-[72px_minmax(0,1fr)_minmax(300px,0.9fr)] lg:gap-8`}>
            <div class="font-mono text-3xl font-bold text-primary/40 leading-none tabular-nums">
              {service.number}
            </div>

            <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
              <div class="mb-3 font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground">{service.label}</div>
              <h3 class="text-base font-semibold text-foreground">{service.heading}</h3>
              <p class="mt-4 text-sm leading-[1.8] text-muted-foreground/88">
                {service.body}
              </p>
              <p class="mt-5 font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground leading-[1.9]">
                {service.includes.join(' • ')}
              </p>
              <p class="mt-5 text-sm leading-[1.8] text-muted-foreground/88">
                <span class="text-foreground">Best fit:</span> {service.audience}
              </p>
            </div>

            <div class={i % 2 === 1 ? 'lg:order-1' : ''}>
              <div class="overflow-hidden border-y border-border/80">
                <img
                  src={service.image}
                  alt={service.imageAlt}
                  class="aspect-[16/10] w-full object-cover object-top"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="process" class="py-12 sm:py-14 scroll-mt-28">
      <div class="max-w-[56ch] reveal">
        <div class="section-kicker">Process</div>
        <h2 class="type-h2 mt-4">How the work moves</h2>
        <p class="mt-4 text-sm leading-[1.8] text-muted-foreground/88">
          Straightforward process, clear scope, and a bias toward momentum.
        </p>
      </div>

      <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((step, i) => (
          <div class={`reveal reveal-d${i + 1} border-t border-border/80 pt-4`}>
            <div class="mb-3 font-mono text-[11px] uppercase tracking-[0.18em] text-primary/70">
              0{step.number}
            </div>
            <h3 class="text-base font-semibold text-foreground">{step.title}</h3>
            <p class="mt-2 text-sm leading-[1.8] text-muted-foreground/88">{step.description}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="about" class="py-12 sm:py-14 scroll-mt-28">
      <div class="reveal grid gap-10 lg:grid-cols-[minmax(0,1fr)_260px] lg:gap-16">
        <div>
          <div class="section-kicker mb-3">Background</div>
          <h2 class="type-h2">Why this work fits me</h2>
          <div class="mt-8 grid gap-5">
            <div class="border-t border-border/80 pt-4 text-sm leading-[1.8] text-muted-foreground/88">
              I have worked across banking, retail, property, hospitality, and technology. Design is the common thread, but the reason clients hire me is usually the combination: structured product thinking, strong UI judgment, and enough implementation depth to keep the work moving.
            </div>
            <div class="border-t border-border/80 pt-4 text-sm leading-[1.8] text-muted-foreground/88">
              That mix is especially useful when the work is ambiguous at the start, the timeline matters, and there is real value in having the person shaping the product also understand how it will actually get built.
            </div>
          </div>
        </div>

        <aside class="grid gap-4 lg:pt-12">
          <div class="border-t border-border/80 pt-4">
            <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Based</div>
            <div class="mt-2 text-sm text-foreground">Cape Town, South Africa</div>
          </div>
          <div class="border-t border-border/80 pt-4">
            <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Availability</div>
            <div class="mt-2 text-sm leading-6 text-muted-foreground">Available for local and remote projects, plus selected full-time opportunities.</div>
          </div>
        </aside>
      </div>
    </section>

    <section class="pb-14 pt-6 sm:pb-20 sm:pt-10">
      <div class="max-w-[68ch] reveal">
        <div class="section-kicker">Next step</div>
        <h2 class="type-h2 mt-4">
          Ready to get started?
        </h2>
        <p class="mt-4 text-sm leading-[1.8] text-muted-foreground/88">
          Whether you have a clear brief or just an idea you want to talk through, reach out. No pressure, no pitch.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href={calLink} target="_blank" rel="noopener noreferrer" class="btn-stripe">
            Book a free 30-minute call
          </a>
          <a href={`mailto:${emailAddress}`} class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground transition-colors hover:text-foreground">
            Prefer email? {emailAddress}
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
