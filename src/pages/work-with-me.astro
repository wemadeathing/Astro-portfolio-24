---
export const prerender = true;
import Layout from '../layouts/Layout.astro';

const services = [
  {
    number: '01',
    label: 'AI Products, MVPs & Product Design',
    heading: 'From concept to working product, without the handoff gaps.',
    body: "I work across product framing, UX, interface design, and implementation to get products moving fast. When the product is AI-powered, that includes designing how the agents receive context, use their tools, and respond, so it works for the person using it.",
    includes: ['Web and mobile MVPs', 'AI-powered product builds', 'Full stack: design to deployment'],
    audience: 'Founders, product teams, and innovation leads who need a design-minded builder to move from idea to working software.',
    image: '/images/work-with-me-02.png',
    imageAlt: 'Product and MVP development by Nasif Salaam',
  },
  {
    number: '02',
    label: 'High-Trust Digital Presence',
    heading: 'Brand-led websites that make a business feel credible fast.',
    body: "I design and build websites and brand systems for businesses that need to look established and trustworthy. This is the right fit when the offer is strong but the current digital presence makes the business feel smaller than it is.",
    includes: ['New websites from scratch', 'Brand identity: logo, colour, type', 'Redesigns and refreshes'],
    audience: 'Service businesses, founders, and small teams that need a sharper digital presence to support outreach, trust, and lead generation.',
    image: '/images/work-with-me-01.png',
    imageAlt: 'Website and brand identity design by Nasif Salaam',
  },
];

const steps = [
  {
    number: '1',
    title: 'We talk',
    description: "30 minutes. Tell me what you need. I'll be honest about whether I'm the right person.",
  },
  {
    number: '2',
    title: 'I scope it',
    description: "Clear scope, timeline, and price. No vague proposals, no surprise costs.",
  },
  {
    number: '3',
    title: 'We build it',
    description: "I get to work. You stay in the loop. Most projects move fast.",
  },
  {
    number: '4',
    title: 'Something real',
    description: "A product, a website, a brand. You walk away with something that works.",
  },
];

const works = [
  {
    label: 'Kota AI',
    category: 'AI Product',
    image: '/images/work/kota/kota-dash.png',
    href: '/projects/kota-ai',
  },
  {
    label: 'RideNote',
    category: 'iOS App',
    image: '/images/work/ridenote-hero.png',
    href: '/projects/ridenote-ios-app',
  },
  {
    label: 'Flows',
    category: 'AI Builder Tool',
    image: '/images/work/flows/flows-main-app.jpeg',
    href: '/projects/ai-powered-whatsapp-flow-builder',
  },
  {
    label: 'Everprompt',
    category: 'AI Product',
    image: '/images/work/everprompt-app1.png',
    href: '/projects/prompt-management-app',
  },
  {
    label: 'Banking Platform',
    category: 'Enterprise Product',
    image: '/images/fintech-ui-design.png',
    href: '/projects/financial-institution-digital-transformation',
  },
  {
    label: 'ECOS Consulting',
    category: 'Digital Presence',
    image: '/images/work/ecos-consulting-website-1.png',
    href: '/projects/consulting-website',
  },
  {
    label: 'Brand Marks',
    category: 'Brand Identity',
    image: '/images/work/lumina7-arabica-1.jpg',
    href: '/projects/brand-marks',
  },
  {
    label: 'Find Me a Coffee',
    category: 'AI Product',
    image: '/images/work/findmeacoffee/findmeacoffee-home.png',
    href: '/projects/ai-accelerated-coffee-directory',
  },
];

const calLink = 'https://calendly.com/salaam-nasif/30min';
const emailAddress = 'hello@nasifsalaam.com';

const agentMarkdown = `# Work With Me: Nasif Salaam

> Product designer and AI builder focused on AI products, MVPs, and high-trust digital experiences. I help with both product builds and the digital presence that makes them credible.

## Services

${services
  .map(
    (s, idx) => `### ${idx + 1}. ${s.label}

**${s.heading}**

${s.body}

**Includes:**
${s.includes.map((i) => `- ${i}`).join('\n')}

**Best for:** ${s.audience}`
  )
  .join('\n\n')}

## Process

${steps.map((s) => `${s.number}. **${s.title}**: ${s.description}`).join('\n')}

## Get Started

- Book a 30-minute call: ${calLink}
- Email: ${emailAddress}
- Site: https://nasifsalaam.com`;
---

<Layout
  title="Work With Me | Nasif Salaam"
  description="Work with Nasif Salaam on AI products, MVPs, product design, and high-trust digital presence projects."
  agentMarkdown={agentMarkdown}
  agentPathLabel="~/nasifsalaam / work-with-me.md"
  image="/images/work-with-me-02.png"
>

  {/* ── Hero ── */}
  <section class="border-b border-border/60">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 py-14 sm:py-20 lg:grid-cols-[1fr_400px] lg:gap-14 lg:items-start">

        {/* Left: text */}
        <div class="scroll-reveal">
          <div class="section-kicker">Work With Me</div>
          <h1 class="type-h1 mt-4 max-w-[16ch]">
            Product design and AI builds, without the gaps.
          </h1>
          <p class="mt-5 text-sm leading-[1.8] text-muted-foreground/88 max-w-[46ch]">
            One person across product framing, interface design, and build. 15+ years. Open to project work and full-time roles.
          </p>
          <div class="mt-8">
            <a href={calLink} target="_blank" rel="noopener noreferrer" class="btn-stripe min-h-[48px] px-8">
              Book a free 30-minute call
            </a>
          </div>
        </div>

        {/* Right: framed image box */}
        <div class="scroll-reveal scroll-reveal-d2 hidden lg:block">
          <div class="image-frame">
            <div class="frame-stripe" aria-hidden="true"></div>
            <div class="overflow-hidden">
              <img
                src="/images/work-with-me-02.png"
                alt="Product and AI build work by Nasif Salaam"
                class="w-full object-cover object-top"
                style="aspect-ratio: 4/3;"
                loading="eager"
                decoding="async"
              />
            </div>
            <div class="frame-footer">
              <span class="status-dot" aria-hidden="true"></span>
              <span>Available now · Cape Town</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* ── Proof strip ── */}
  <section class="border-b border-border/60">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 divide-x divide-border/60 sm:grid-cols-4">
        <div class="py-7 pr-6 sm:pr-8">
          <div class="font-mono text-xl font-bold tabular-nums text-foreground">15+</div>
          <div class="mt-1 font-mono text-[10px] uppercase tracking-[0.16em] text-muted-foreground leading-snug">Years experience</div>
        </div>
        <div class="py-7 px-6 sm:px-8">
          <div class="font-mono text-xl font-bold tabular-nums text-foreground">2</div>
          <div class="mt-1 font-mono text-[10px] uppercase tracking-[0.16em] text-muted-foreground leading-snug">Disciplines</div>
        </div>
        <div class="py-7 px-6 sm:px-8 border-t border-border/60 sm:border-t-0">
          <div class="font-mono text-xl font-bold tabular-nums text-foreground flex items-center gap-2">
            <span class="status-dot" aria-hidden="true"></span>Open
          </div>
          <div class="mt-1 font-mono text-[10px] uppercase tracking-[0.16em] text-muted-foreground leading-snug">Projects + roles</div>
        </div>
        <div class="py-7 pl-6 sm:pl-8 border-t border-border/60 sm:border-t-0">
          <div class="font-mono text-xl font-bold tabular-nums text-foreground">Remote</div>
          <div class="mt-1 font-mono text-[10px] uppercase tracking-[0.16em] text-muted-foreground leading-snug">Cape Town based</div>
        </div>
      </div>
    </div>
  </section>

  {/* ── Work strip ── */}
  <section class="py-12 sm:py-16 border-b border-border/60">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8 mb-6 flex items-center justify-between">
      <div class="section-kicker">Selected Work</div>
      <a href="/projects" class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted-foreground transition-colors hover:text-foreground">
        View all →
      </a>
    </div>
    <div class="work-strip-outer">
      <div class="work-strip" id="workStrip">
        {works.map((work) => (
          <a href={work.href} class="work-card">
            <div class="frame-stripe" aria-hidden="true"></div>
            <div class="work-card-img-wrap">
              <img
                src={work.image}
                alt={work.label}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="work-card-footer">
              <span class="work-card-label">{work.label}</span>
              <span class="work-card-cat">{work.category}</span>
            </div>
          </a>
        ))}
      </div>
      <div class="work-strip-fade" aria-hidden="true"></div>
    </div>
  </section>

  <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">

    {/* ── Services ── */}
    <section id="services" class="py-14 sm:py-20 scroll-mt-28">
      <div class="mb-10">
        <div class="section-kicker">Services</div>
        <h2 class="type-h2 mt-4">Two tracks, one thread.</h2>
        <p class="mt-3 text-sm leading-[1.8] text-muted-foreground/88 max-w-[50ch]">
          Product thinking, interface craft, and implementation kept together end to end.
        </p>
      </div>

      <div class="grid gap-6 lg:grid-cols-2">
        {services.map((service, i) => (
          <div class={`scroll-reveal scroll-reveal-d${i + 1} service-card`}>
            <div class="frame-stripe" aria-hidden="true"></div>
            <div class="p-6 flex flex-col h-full">
              <div class="flex items-start justify-between gap-4 mb-5">
                <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground">{service.label}</span>
                <span class="font-mono text-2xl font-bold text-primary/25 leading-none tabular-nums shrink-0">{service.number}</span>
              </div>
              <h3 class="text-base font-semibold text-foreground leading-snug">{service.heading}</h3>
              <p class="mt-3 text-sm leading-[1.8] text-muted-foreground/88 flex-1">{service.body}</p>
              <div class="mt-5 border-t border-border/60 pt-5">
                <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted-foreground leading-[2]">
                  {service.includes.join(' · ')}
                </p>
              </div>
              <div class="mt-4 overflow-hidden border border-border/60">
                <img
                  src={service.image}
                  alt={service.imageAlt}
                  class="aspect-[16/9] w-full object-cover object-top"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <p class="mt-4 text-xs leading-[1.7] text-muted-foreground/70">
                <span class="text-foreground/70">Best fit: </span>{service.audience}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* ── Process ── */}
    <section id="process" class="py-14 sm:py-20 scroll-mt-28 border-t border-border/60">
      <div class="mb-10 scroll-reveal">
        <div class="section-kicker">Process</div>
        <h2 class="type-h2 mt-4">How the work moves</h2>
      </div>

      <div class="grid gap-px bg-border/40 border border-border/40 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((step, i) => (
          <div class={`scroll-reveal scroll-reveal-d${i + 1} bg-background p-6`}>
            <div class="mb-4 font-mono text-[10px] uppercase tracking-[0.18em] text-primary/60">
              0{step.number}
            </div>
            <h3 class="text-sm font-semibold text-foreground">{step.title}</h3>
            <p class="mt-2 text-xs leading-[1.8] text-muted-foreground/80">{step.description}</p>
          </div>
        ))}
      </div>
    </section>

    {/* ── Closing CTA ── */}
    <section class="pb-16 pt-4 sm:pb-24">
      <div class="scroll-reveal cta-box">
        <div class="frame-stripe" aria-hidden="true"></div>
        <div class="p-8 sm:p-10 grid gap-6 sm:grid-cols-[1fr_auto] sm:items-center">
          <div>
            <div class="section-kicker mb-3">Next step</div>
            <h2 class="type-h2">Have a project or a role in mind?</h2>
            <p class="mt-3 text-sm leading-[1.8] text-muted-foreground/88 max-w-[46ch]">
              Reach out. Whether you have a brief or just an idea, I'll tell you honestly if it's a good fit.
            </p>
          </div>
          <div class="flex flex-col gap-3 sm:items-end">
            <a href={calLink} target="_blank" rel="noopener noreferrer" class="btn-stripe min-h-[48px] px-8 whitespace-nowrap">
              Book a free call
            </a>
            <a href={`mailto:${emailAddress}`} class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted-foreground transition-colors hover:text-foreground text-center sm:text-right">
              {emailAddress}
            </a>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>

<style>
  /* ── Shared stripe band ── */
  .frame-stripe {
    height: 22px;
    flex-shrink: 0;
    background-image: repeating-linear-gradient(
      119deg,
      color-mix(in srgb, hsl(var(--foreground)) 14%, transparent) 0 1px,
      transparent 1px 5px
    );
    background-color: hsl(var(--muted) / 0.35);
  }

  /* ── Status dot ── */
  .status-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: hsl(var(--primary));
    flex-shrink: 0;
  }

  /* ── Hero image frame ── */
  .image-frame {
    border: 1px solid hsl(var(--border) / 0.8);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .frame-footer {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.6rem 0.875rem;
    border-top: 1px solid hsl(var(--border) / 0.7);
    font-family: "Geist Mono", ui-monospace, monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: hsl(var(--muted-foreground));
  }

  /* ── Work strip ── */
  .work-strip-outer {
    position: relative;
  }

  .work-strip {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 0 1rem 0.5rem;
    cursor: grab;
    user-select: none;
  }

  .work-strip::-webkit-scrollbar {
    display: none;
  }

  .work-strip.dragging {
    cursor: grabbing;
  }

  .work-strip-fade {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0.5rem;
    width: 100px;
    background: linear-gradient(to right, transparent, hsl(var(--background)));
    pointer-events: none;
  }

  .work-card {
    flex-shrink: 0;
    width: 220px;
    border: 1px solid hsl(var(--border) / 0.7);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: border-color 200ms ease;
  }

  .work-card:hover {
    border-color: hsl(var(--foreground) / 0.4);
  }

  .work-card-img-wrap {
    overflow: hidden;
    background: hsl(var(--muted) / 0.3);
  }

  .work-card-img-wrap img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    object-position: top;
    display: block;
    transition: transform 400ms ease;
  }

  .work-card:hover .work-card-img-wrap img {
    transform: scale(1.03);
  }

  .work-card-footer {
    padding: 0.625rem 0.75rem;
    border-top: 1px solid hsl(var(--border) / 0.6);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .work-card-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: hsl(var(--foreground));
    line-height: 1.3;
  }

  .work-card-cat {
    font-family: "Geist Mono", ui-monospace, monospace;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: hsl(var(--muted-foreground));
  }

  /* ── Service cards ── */
  .service-card {
    border: 1px solid hsl(var(--border) / 0.8);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* ── CTA box ── */
  .cta-box {
    border: 1px solid hsl(var(--border) / 0.8);
    overflow: hidden;
  }
</style>

<script is:inline>
  const strip = document.getElementById('workStrip');
  if (strip) {
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;

    strip.addEventListener('mousedown', (e) => {
      isDown = true;
      strip.classList.add('dragging');
      startX = e.pageX - strip.offsetLeft;
      scrollLeft = strip.scrollLeft;
    });

    strip.addEventListener('mouseleave', () => {
      isDown = false;
      strip.classList.remove('dragging');
    });

    strip.addEventListener('mouseup', () => {
      isDown = false;
      strip.classList.remove('dragging');
    });

    strip.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - strip.offsetLeft;
      const walk = (x - startX) * 1.5;
      strip.scrollLeft = scrollLeft - walk;
    });
  }
</script>
