---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

const services = [
  {
    number: '01',
    label: 'High-Trust Digital Presence',
    heading: 'Brand-led websites that make a business feel credible fast.',
    body: "I design and build websites and supporting brand systems for businesses that need to look established, clear, and trustworthy. This is a good fit when the offer is strong but the current digital presence is making the business feel smaller than it is.",
    includes: [
      'New websites from scratch',
      'Brand identity: logo, colours, typography',
      'Redesigns and refreshes',
    ],
    audience: 'Service businesses, founders, and small teams that need a sharper digital presence to support outreach, trust, and lead generation.',
    image: '/images/work-with-me-01.png',
    imageAlt: 'Website and brand identity design by Nasif Salaam',
  },
  {
    number: '02',
    label: 'AI Products, MVPs & Product Design',
    heading: 'From concept to working product, without the usual handoff gaps.',
    body: "I work across product framing, UX, system thinking, interface design, and implementation to get products moving quickly. This is the stronger fit when you need an MVP, an internal AI tool, or someone who can bridge product design and build.",
    includes: [
      'Web and mobile MVPs',
      'AI-powered product builds',
      'Full stack: design to deployment',
    ],
    audience: 'Founders, product teams, and innovation leads who need a design-minded builder to move from idea to working software.',
    image: '/images/work-with-me-02.png',
    imageAlt: 'Product and MVP development by Nasif Salaam',
  },
];

const steps = [
  {
    number: '1',
    title: 'We talk',
    description: "Book a free 30-minute call. Tell me what you need. I'll tell you honestly whether I'm the right person to help.",
  },
  {
    number: '2',
    title: 'I put a plan together',
    description: "Based on our conversation, I'll come back with a clear scope, timeline, and price. No vague proposals.",
  },
  {
    number: '3',
    title: 'We build it',
    description: "I get to work. You stay in the loop. Most projects move fast. I'm not the kind of person who disappears for weeks.",
  },
  {
    number: '4',
    title: "You've got something real",
    description: "Whether it's a website, a product, or a refreshed brand, you walk away with something that works.",
  },
];

const calLink = 'https://calendly.com/salaam-nasif/30min';
const emailAddress = 'hello@nasifsalaam.com';

const agentMarkdown = `# Work With Me: Nasif Salaam

> Product designer and AI builder focused on AI products, MVPs, and high-trust digital experiences. I help with both product builds and the digital presence that makes them credible.

## Services

${services
  .map(
    (s, idx) => `### ${idx + 1}. ${s.label}

**${s.heading}**

${s.body}

**Includes:**
${s.includes.map((i) => `- ${i}`).join('\n')}

**Best for:** ${s.audience}`
  )
  .join('\n\n')}

## Process

${steps.map((s) => `${s.number}. **${s.title}**: ${s.description}`).join('\n')}

## Get Started

- Book a 30-minute call: ${calLink}
- Email: ${emailAddress}
- Site: https://nasifsalaam.com`;
---

<Layout
  title="Work With Me | Nasif Salaam"
  description="Work with Nasif Salaam on AI products, MVPs, product design, and high-trust digital presence projects."
  agentMarkdown={agentMarkdown}
  agentPathLabel="~/nasifsalaam / work-with-me.md"
  image="/images/work-with-me-01.png"
>
  <!-- Hero -->
  <section class="py-10 sm:py-14">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-[68ch]">
        <h1 class="text-4xl sm:text-5xl md:text-[54px] font-medium tracking-[-0.03em] leading-[1.05] text-white/95">
          Product design, AI build work, and digital presence that earns trust.
        </h1>
        <p class="mt-5 type-lead text-white/80">
          I work in two lanes: AI products and MVPs that need to get real quickly, and high-trust websites or brand-led digital experiences for businesses that need to look as strong as they are.
        </p>
        <p class="mt-3 max-w-[58ch] text-sm sm:text-base leading-[1.7] text-white/62">
          Product Designer / AI Builder, with enough implementation depth to keep the work moving and enough design judgment to keep it coherent.
        </p>
        <div class="mt-7">
          <Button href={calLink} text="Book a free 30-minute call →" variant="primary" external />
        </div>
      </div>
    </div>
  </section>

  <div class="h-px bg-white/10"></div>

  <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">

    <!-- What I Can Do For You -->
    <section id="services" class="py-12 sm:py-14 scroll-mt-28">
      <div class="mb-10">
        <div class="text-xs tracking-[0.22em] uppercase text-white/50 mb-3">Services</div>
        <h2 class="type-h2 text-white/90">What I can do for you</h2>
        <p class="mt-3 type-lead text-white/78 max-w-[56ch]">
          These are the two kinds of work where I add the most value fastest.
        </p>
      </div>

      <div class="space-y-5">
        {services.map((service, i) => (
          <div class="group rounded-[24px] border border-white/8 bg-white/[0.025] overflow-hidden transition-colors hover:bg-white/[0.04] hover:border-white/12">
            <div class:list={[
              'grid grid-cols-1 lg:grid-cols-2 gap-0',
              i % 2 === 1 ? 'lg:[direction:rtl]' : '',
            ]}>
              {/* Image */}
              <div class="relative aspect-[16/10] lg:aspect-auto overflow-hidden lg:[direction:ltr]">
                <img
                  src={service.image}
                  alt={service.imageAlt}
                  class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent lg:bg-none"></div>
              </div>

              {/* Content */}
              <div class="p-6 sm:p-8 flex flex-col justify-center lg:[direction:ltr]">
                <div class="flex items-baseline gap-3">
                  <span class="text-primary font-semibold text-sm tabular-nums">{service.number}</span>
                  <span class="text-xs tracking-[0.22em] uppercase text-white/50">{service.label}</span>
                </div>

                <h3 class="text-lg sm:text-xl font-semibold text-white/92 mt-3">
                  {service.heading}
                </h3>

                <p class="mt-3 text-sm leading-[1.65] text-white/78">
                  {service.body}
                </p>

                <p class="mt-4 text-xs uppercase tracking-[0.16em] text-white/42 leading-[1.8]">
                  {service.includes.join(' • ')}
                </p>

                <p class="mt-4 text-xs text-white/45 leading-[1.6]">
                  <span class="text-white/55 font-medium">For:</span> {service.audience}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <div class="h-px bg-white/10"></div>

    <!-- How It Works -->
    <section id="process" class="py-12 sm:py-14 scroll-mt-28">
      <div class="mb-10">
        <div class="text-xs tracking-[0.22em] uppercase text-white/50 mb-3">Process</div>
          <h2 class="type-h2 text-white/90">How it works</h2>
          <p class="mt-3 type-lead text-white/78 max-w-[56ch]">
          Straightforward process, clear scope, and a bias toward momentum.
          </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {steps.map((step) => (
          <div class="border-t border-white/10 pt-5 sm:pt-6">
            <div class="text-[11px] uppercase tracking-[0.22em] text-primary/75 mb-4">
              {step.number}
            </div>
            <h3 class="text-base font-semibold text-white/90">{step.title}</h3>
            <p class="mt-2 text-sm text-white/72 leading-[1.65]">{step.description}</p>
          </div>
        ))}
      </div>
    </section>

    <div class="h-px bg-white/10"></div>

    <!-- About Me -->
    <section id="about" class="py-12 sm:py-14 scroll-mt-28">
      <div class="mb-8">
        <div class="text-xs tracking-[0.22em] uppercase text-white/50 mb-3">Background</div>
        <h2 class="type-h2 text-white/90">A bit about me</h2>
      </div>

      <div class="rounded-[24px] border border-white/8 bg-white/[0.025] p-6 sm:p-8">
        <div class="flex flex-col lg:flex-row gap-8 items-start lg:items-center">
          <div class="space-y-4 text-sm sm:text-base leading-[1.65] text-white/75 lg:flex-1">
            <p>
              I have worked across banking, retail, property, hospitality, and technology. Design is the common thread, but the reason clients hire me is usually the combination: structured product thinking, strong UI judgment, and enough implementation depth to keep the work moving.
            </p>
          </div>
          <div class="hidden lg:block lg:shrink-0 lg:w-[180px] xl:w-[200px]">
            <img
              src="/images/NS-profile-2.png"
              alt="Nasif Salaam"
              class="w-full aspect-square object-cover rounded-2xl"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="pb-14 sm:pb-20">
      <div class="rounded-[28px] border border-white/8 bg-white/[0.025] p-8 sm:p-10">
        <div class="max-w-[72ch]">
          <h2 class="type-h2 text-white/92">
            Ready to get started?
          </h2>
          <p class="mt-3 text-base sm:text-lg leading-[1.65] text-white/80">
            Whether you've got a clear brief or just an idea you want to talk through, reach out. No pressure, no pitch.
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <Button href={calLink} text="Book a free 30-minute call →" variant="primary" external />
            <span class="text-sm text-white/55">
              Prefer email? <a href={`mailto:${emailAddress}`} class="text-white/80 underline underline-offset-4 decoration-white/25 hover:text-white hover:decoration-white/50 transition-colors">{emailAddress}</a>
            </span>
          </div>
        </div>
      </div>
    </section>

  </div>

  <!-- Footer note -->
  <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8 pb-6">
    <p class="text-xs text-white/40 text-center">
      Based in Cape Town. Available for local and remote projects.
    </p>
  </div>
</Layout>
