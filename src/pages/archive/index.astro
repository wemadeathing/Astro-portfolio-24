---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import { archiveProjects } from '../../data/archive';
import { buildArchiveIndexAgentMarkdown } from '../../lib/agent-content';

const { markdown: agentMarkdown, pathLabel: agentPathLabel } = buildArchiveIndexAgentMarkdown();

const hatchStyle =
  'background-image: repeating-linear-gradient(119deg, hsl(var(--foreground) / 0.08) 0 1px, transparent 1px 5px);';
---

<Layout
  title="Archive | Older Client Work"
  description="Older client work from the print and brand years. Everything here was created from scratch: concept and illustration through print production."
  agentMarkdown={agentMarkdown}
  agentPathLabel={agentPathLabel}
>
  <section class="py-10 sm:py-14">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-[68ch] scroll-reveal">
        <div>
          <a
            href="/projects"
            class="font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground transition-colors hover:text-foreground"
          >
            &#8592; All work
          </a>
        </div>
        <div class="section-kicker mt-8">From the vault</div>
        <h1 class="type-h1 mt-4">Archive</h1>
        <p class="mt-4 type-lead">
          Older client work from the print and brand years. Everything here was created from
          scratch: concept and illustration through print production.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-3 stagger-children">
        {archiveProjects.map((project) => (
          <a
            href={`/archive/${project.slug}`}
            class="group flex h-full flex-col border border-border/80 transition-colors hover:border-primary/35 focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/20"
          >
            {/* Folder well: 2x2 preview of the work inside */}
            <div class="bg-muted/20 p-3 sm:p-4">
              <div class="grid grid-cols-2 gap-1.5">
                {project.images.slice(0, 4).map((img) => (
                  <div class="relative aspect-square overflow-hidden bg-muted/20">
                    <div class="absolute inset-0 skeleton-image" aria-hidden="true"></div>
                    <img
                      src={img}
                      alt=""
                      class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.05]"
                      loading="lazy"
                      decoding="async"
                      onload="this.parentElement.querySelector('.skeleton-image').style.display='none'"
                    />
                  </div>
                ))}
                {Array.from({ length: Math.max(0, 4 - project.images.length) }).map(() => (
                  <div class="aspect-square" style={hatchStyle} aria-hidden="true"></div>
                ))}
              </div>
            </div>

            {/* Label */}
            <div class="mt-auto flex items-center gap-2 border-t border-border/60 p-3 sm:p-4">
              <span class="text-sm font-semibold leading-snug text-foreground transition-colors group-hover:text-primary">
                {project.name}
              </span>
              <span class="ml-auto whitespace-nowrap font-mono text-[10px] uppercase tracking-[0.18em] text-muted-foreground">
                {project.images.length} {project.images.length === 1 ? 'image' : 'images'}
              </span>
              <svg
                class="h-3 w-3 shrink-0 -translate-x-1 text-primary opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100"
                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
              >
                <path d="M7 17L17 7" /><path d="M7 7h10v10" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
