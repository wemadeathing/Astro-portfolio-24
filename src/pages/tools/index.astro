---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';

const tools = [
  {
    title: 'llms.txt Generator',
    description: 'Create a standard "map" file for AI agents to easily understand your website structure.',
    href: '/tools/llms-generator',
    icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
    badge: 'New'
  }
];
---

<Layout
  title="Free AI & SEO Tools | Nasif Salaam"
  description="Free tools to help you optimize your website for the AI era. Generate standard llms.txt files for crawlers and agents."
>
  <section class="py-10 sm:py-14">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-[68ch]">
        <div class="shell-rule">
          <div class="section-kicker">Tools</div>
          <h1 class="type-h1 mt-4">Tools</h1>
        </div>
        <p class="mt-4 type-lead text-muted-foreground">
          Small utilities to help you build better for the AI-powered web.
        </p>
      </div>

      <div class="mt-12 max-w-[860px]">
        {tools.map(tool => (
          <a
            href={tool.href}
            class="group grid gap-6 border-t border-border/80 pt-5 lg:grid-cols-[72px_minmax(0,1fr)_auto] lg:items-start focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/20"
          >
            <div class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">
              01
            </div>

            <div>
              <div class="mb-3 font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground">
                {tool.badge ? `${tool.badge} Tool` : 'Tool'}
              </div>
              <h2 class="text-xl font-semibold text-foreground transition-colors group-hover:text-primary sm:text-2xl">
                {tool.title}
              </h2>
              <p class="mt-3 max-w-[52ch] text-sm leading-[1.8] text-muted-foreground sm:text-base">
                {tool.description}
              </p>
              <div class="mt-5 inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.16em] text-foreground">
                <span class="h-px w-8 bg-primary/80" aria-hidden="true"></span>
                Try tool
              </div>
            </div>

            <div class="flex items-start gap-3 lg:justify-end">
              <div class="flex h-12 w-12 items-center justify-center border border-border/80 text-muted-foreground transition-colors group-hover:border-primary/35 group-hover:text-foreground">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d={tool.icon} />
                </svg>
              </div>
              {tool.badge && (
                <span class="inline-flex items-center border-t border-border/80 pt-3 font-mono text-[11px] uppercase tracking-[0.16em] text-primary">
                  {tool.badge}
                </span>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
