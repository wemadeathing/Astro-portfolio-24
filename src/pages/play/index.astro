---
import Layout from '../../layouts/Layout.astro';

export const prerender = true;
---

<Layout
  title="Play | Unlisted"
  description="Unlisted playground route."
  robots="noindex, nofollow"
>
  <section class="py-10 sm:py-14">
    <div class="container max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-[68ch]">
        <div class="shell-rule">
          <div class="section-kicker">Play</div>
          <h1 class="mt-4 type-h1">Unlisted</h1>
        </div>
        <p class="mt-4 type-lead text-muted-foreground">
          This page is intentionally hidden from navigation.
        </p>
        <div class="mt-8 border-t border-border/80 pt-5">
          <p class="text-sm leading-relaxed text-muted-foreground">
            The game experiments have been removed for now while we focus on the core site experience.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
